    {
      "id": 1,
      "plugin": "Cardinal",
      "model": "TextEditor",
      "version": "2.0.0",
      "params": [],
      "data": {
        "filepath": "",
        "lang": "None",
        "etext": "HELM KEYS - poly synth + reverb\n\nPlay chords. Up to 8 voices.\n\nSignal path:\n  HostMIDI -> VCO -> VCF -> VCA -> Sum -> Plateau -> Out\n  ADSR opens the VCA and sweeps the filter\n  Sum  = folds the 8 voices down to one mono signal\n\nTweak me:\n- VCF  CUTOFF / RESO  = brightness + squelch\n- VCF  FREQ CV amount = how much the envelope\n  opens the filter (the 'pluck')\n- ADSR A D S R        = attack bite / release\n- VCO  SAW jack       = try SIN / TRI / SQR\n- Plateau WET / SIZE / DECAY = the space\n- Sum  LEVEL          = master trim\n\nVoices: right-click HostMIDI -> Polyphony channels\n\n",
        "width": 26
      },
      "pos": [
        -3,
        0
      ]
    },
