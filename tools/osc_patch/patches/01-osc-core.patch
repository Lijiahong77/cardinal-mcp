+static std::string oscJsonDumpsCompact(json_t* j)
+{
+    if (j == NULL)
+        return std::string("null");
+    char* s = json_dumps(j, JSON_COMPACT);
+    std::string out = s ? s : "";
+    if (s)
+        free(s);
+    return out;
+}
