diff --git a/include/simd-compat/immintrin.h b/include/simd-compat/immintrin.h
index 572a2b6..d9f5a86 100644
--- a/include/simd-compat/immintrin.h
+++ b/include/simd-compat/immintrin.h
@@ -10,7 +10,43 @@
 
 #if defined(CARDINAL_INCLUDING_EMULATED_IMMINTRIN_H) || defined(SIMDE_X86_SSE_NATIVE)
 # define CARDINAL_INCLUDING_IMMINTRIN_H
+/* Cardinal patch 2026-09-20 (mingw GCC 13): simde 在 native-aliases 模式下为
+   AVX512VL 的 _mm_loadu_epi8/16/32/64 生成宏；随后包含原生 <immintrin.h> 时，
+   avx512vlintrin.h 里的同名函数定义会被宏替换成 simde_mm_* 造成重定义。
+   包含原生头前临时解除，包含完再恢复。 */
+# ifdef _mm_loadu_epi8
+#  undef _mm_loadu_epi8
+#  define CARDINAL_RESTORE_MM_LOADU_EPI8
+# endif
+# ifdef _mm_loadu_epi16
+#  undef _mm_loadu_epi16
+#  define CARDINAL_RESTORE_MM_LOADU_EPI16
+# endif
+# ifdef _mm_loadu_epi32
+#  undef _mm_loadu_epi32
+#  define CARDINAL_RESTORE_MM_LOADU_EPI32
+# endif
+# ifdef _mm_loadu_epi64
+#  undef _mm_loadu_epi64
+#  define CARDINAL_RESTORE_MM_LOADU_EPI64
+# endif
 # include_next <immintrin.h>
+# ifdef CARDINAL_RESTORE_MM_LOADU_EPI8
+#  undef CARDINAL_RESTORE_MM_LOADU_EPI8
+#  define _mm_loadu_epi8(a) simde_mm_loadu_epi8(a)
+# endif
+# ifdef CARDINAL_RESTORE_MM_LOADU_EPI16
+#  undef CARDINAL_RESTORE_MM_LOADU_EPI16
+#  define _mm_loadu_epi16(a) simde_mm_loadu_epi16(a)
+# endif
+# ifdef CARDINAL_RESTORE_MM_LOADU_EPI32
+#  undef CARDINAL_RESTORE_MM_LOADU_EPI32
+#  define _mm_loadu_epi32(a) simde_mm_loadu_epi32(a)
+# endif
+# ifdef CARDINAL_RESTORE_MM_LOADU_EPI64
+#  undef CARDINAL_RESTORE_MM_LOADU_EPI64
+#  define _mm_loadu_epi64(a) simde_mm_loadu_epi64(a)
+# endif
 # undef CARDINAL_INCLUDING_IMMINTRIN_H
 #else
 # define CARDINAL_INCLUDING_EMULATED_IMMINTRIN_H
