+	float rightMessages[2][MA::MA_MSG_SIZE] = {{0.f}};
+
+	// ---- 本时间步要发给扩展器的键盘事件 ----
+	float outEvents[MA::MA_MSG_EVENTS][MA::MA_MSG_EV_STRIDE] = {{0.f}};
+	int   outEventCount = 0;
+
+	// ---- UI 只读快照（定长 POD，音频线程写、UI 线程读）----
+	MA::MaSnapNote   noteSnap[MA::MA_TRACKS][MA::MA_MAX_NOTES];
+	std::atomic<int> snapNoteCount[MA::MA_TRACKS];
+
+	// ---- 剪贴板导入：UI 线程解析、音频线程落库 ----
+	std::mutex              importMutex;
+	std::vector<MA::MaNote> importNotes;
+	std::atomic<int>        importTarget{-1};
+	std::atomic<bool>       clearRequest{false};
+	std::atomic<float>      importFlash{0.f};    // 面板提示倒计时（秒）
