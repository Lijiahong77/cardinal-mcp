new file mode 100755
index 0000000..a88d531
--- /dev/null
+++ b/plugins/Starsea/src/ArrangerData.hpp
@@ -0,0 +1,461 @@
+/*
+ * Starsea plugin for Cardinal
+ * MiniArranger - data model
+ *
+ * 设计要点（2026-09-21 拍板）：
+ *  - 一个模块内部装 N 条独立声部（多轨），不拆成两块
+ *  - 主模块自带 4 轨；扩展器各持有自己那几轨的数据
+ *    （所以「拔掉扩展器」= 它的轨跟着走，主模块不受影响）
+ *  - 每个音符带「时长」字段 —— 现成 rcm-pianoroll 缺这个
+ *  - CLOCK / RESET / RUN / RECORD 的语义照抄 rcm-pianoroll
+ *  - 内部时间单位 = 格（step），导出 Portable Sequence 时折算成
+ *    「1.0 = 一个四分音符」的浮点，可以直接喂给 Aria / Impromptu 的音序器
+ *
+ * 编辑语法（照抄 CVfunk/Arrange 的「旋钮 = 当前步」范式，见 PROJECT2-SPEC §14.3 #1）：
+ *   面板上不画 N x M 网格；只画「当前步」，步一变就把那一列的值灌进旋钮，
+ *   你一拧旋钮，值就写回那一列。竞态由 isEditing 标志挡（在 Module 里）。
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include "plugin.hpp"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+namespace StarseaArranger {
+
+// ---------------------------------------------------------------------------
+// 常量
+// ---------------------------------------------------------------------------
+static const int MA_TRACKS            = 4;   // 主模块自带轨数（= 面板上 4 列输出）
+static const int MA_MAX_MEASURES      = 64;  // 每轨最长小节数
+static const int MA_STEPS_PER_MEASURE = 16;  // 4/4 下每小节 16 格（4 拍 x 4 格）
+static const int MA_MAX_LENGTH        = 16;  // 单个音符最长 16 格（= 一小节）
+static const int MA_PITCH_MIN         = 12;
+static const int MA_PITCH_MAX         = 108;
+
+// 编辑层：一次只编辑一个字段（照抄 CVfunk 的分层思路，见 §14.3 #9）
+enum MaLayer {
+	MA_LAYER_PITCH = 0,
+	MA_LAYER_LENGTH,
+	MA_LAYER_VELOCITY,
+	MA_NUM_LAYERS
+};
+
+// ---------------------------------------------------------------------------
+// 一个音符
+//   step     : 起始格，从 0 起
+//   length   : 持续几格（>= 1）—— 这就是现成件缺的那个字段
+//   pitch    : MIDI 音高 0..127（输出时转 V/Oct：(pitch - 60) / 12）
+//   velocity : 0..1（导出 Portable Sequence 时 x10）
+// ---------------------------------------------------------------------------
+struct MaNote {
+	int   step     = 0;
+	int   length   = 1;
+	int   pitch    = 60;
+	float velocity = 0.8f;
+
+	bool operator<(const MaNote& other) const {
+		if (step != other.step)
+			return step < other.step;
+		return pitch < other.pitch;
+	}
+
+	void clampValues() {
+		if (step < 0) step = 0;
+		if (length < 1) length = 1;
+		if (length > MA_MAX_LENGTH) length = MA_MAX_LENGTH;
+		if (pitch < MA_PITCH_MIN) pitch = MA_PITCH_MIN;
+		if (pitch > MA_PITCH_MAX) pitch = MA_PITCH_MAX;
+		if (velocity < 0.f) velocity = 0.f;
+		if (velocity > 1.f) velocity = 1.f;
+	}
+
+	bool soundingAt(const int s) const {
+		return (s >= step) && (s < step + length);
+	}
+
+	json_t* toJson() const {
+		json_t* const o = json_object();
+		json_object_set_new(o, "step",     json_integer(step));
+		json_object_set_new(o, "length",   json_integer(length));
+		json_object_set_new(o, "pitch",    json_integer(pitch));
+		json_object_set_new(o, "velocity", json_real(velocity));
+		return o;
+	}
+
+	static MaNote fromJson(json_t* const o) {
+		MaNote n;
+		if (o == nullptr)
+			return n;
+
+		json_t* j = json_object_get(o, "step");
+		if (j != nullptr) n.step = int(json_integer_value(j));
+		j = json_object_get(o, "length");
+		if (j != nullptr) n.length = int(json_integer_value(j));
+		j = json_object_get(o, "pitch");
+		if (j != nullptr) n.pitch = int(json_integer_value(j));
+		j = json_object_get(o, "velocity");
+		if (j != nullptr) n.velocity = float(json_real_value(j));
+
+		n.clampValues();
+		return n;
+	}
+};
+
+// ---------------------------------------------------------------------------
+// 一条轨 = 一个声部（鼓 / 贝斯 / 琴 / 弦乐 ...）
+// ---------------------------------------------------------------------------
+struct MaTrack {
+	std::string         label;      // 显示名，例如 "Drums"
+	bool                mute     = false;
+	int                 measures = 4;   // 本轨长度（小节数）
+	std::vector<MaNote> notes;          // 始终按 step 排序
+
+	MaTrack() {}
+
+	int maxSteps() const {
+		int m = measures;
+		if (m < 1) m = 1;
+		if (m > MA_MAX_MEASURES) m = MA_MAX_MEASURES;
+		return m * MA_STEPS_PER_MEASURE;
+	}
+
+	void sortNotes() {
+		std::stable_sort(notes.begin(), notes.end());
+	}
+
+	// --- 查询 -----------------------------------------------------------
+	// 在 s 处「正在响」的音符下标（含跨步延音）；没有则 -1。
+	// 列表已排序，从后往前扫，取最后一个开始的（= 最新的）。
+	int indexSounding(const int s) const {
+		int found = -1;
+		for (int i = int(notes.size()) - 1; i >= 0; --i) {
+			if (notes[i].soundingAt(s)) {
+				found = i;
+				break;
+			}
+		}
+		return found;
+	}
+
+	// --- 编辑 -----------------------------------------------------------
+	// 删掉所有覆盖 s 的音符（录制新的之前先清干净，避免叠音）
+	void clearAt(const int s) {
+		for (int i = int(notes.size()) - 1; i >= 0; --i) {
+			if (notes[i].soundingAt(s))
+				notes.erase(notes.begin() + i);
+		}
+	}
+
+	// 取 s 处的音符下标；没有就造一个（用于「拧旋钮即创建」）
+	int ensureNoteAt(const int s, const int defaultPitch) {
+		int idx = indexSounding(s);
+		if (idx >= 0)
+			return idx;
+
+		MaNote n;
+		n.step   = s;
+		n.length = 1;
+		n.pitch  = defaultPitch;
+		notes.push_back(n);
+		sortNotes();
+
+		// 重新定位（排序后下标会变）
+		for (size_t i = 0; i < notes.size(); ++i) {
+			if (notes[i].step == s) {
+				idx = int(i);
+				break;
+			}
+		}
+		return idx;
+	}
+
+	void pushNote(const MaNote& note) {
+		notes.push_back(note);
+	}
+
+	// --- 存取 -----------------------------------------------------------
+	json_t* toJson() const {
+		json_t* const t = json_object();
+		json_object_set_new(t, "label",    json_string(label.c_str()));
+		json_object_set_new(t, "mute",     json_boolean(mute));
+		json_object_set_new(t, "measures", json_integer(measures));
+
+		json_t* const arr = json_array();
+		for (size_t i = 0; i < notes.size(); ++i)
+			json_array_append_new(arr, notes[i].toJson());
+		json_object_set_new(t, "notes", arr);
+		return t;
+	}
+
+	void fromJson(json_t* const t) {
+		if (t == nullptr)
+			return;
+
+		json_t* j = json_object_get(t, "label");
+		if (j != nullptr) label = json_string_value(j);
+		j = json_object_get(t, "mute");
+		if (j != nullptr) mute = json_is_true(j);
+		j = json_object_get(t, "measures");
+		if (j != nullptr) measures = int(json_integer_value(j));
+
+		notes.clear();
+		json_t* const arr = json_object_get(t, "notes");
+		if (arr != nullptr) {
+			size_t idx;
+			json_t* n;
+			json_array_foreach(arr, idx, n)
+				notes.push_back(MaNote::fromJson(n));
+		}
+		sortNotes();
+	}
+};
+
+// ---------------------------------------------------------------------------
+// 一台模块持有的全部轨
+//   主模块 = 一份 MaUnit（4 轨）；每块扩展器各有一份自己的 MaUnit
+// ---------------------------------------------------------------------------
+struct MaUnit {
+	MaTrack tracks[MA_TRACKS];
+	int     tracksUsed      = MA_TRACKS;  // 扩展器可以只填前 N 条
+	int     editTrack       = 0;          // 当前编辑 / 录制轨
+	float   stepsPerQuarter = 4.f;        // 每四分音符几格（16 分 = 4）
+
+	MaUnit() { reset(); }
+
+	void reset() {
+		for (int i = 0; i < MA_TRACKS; ++i) {
+			tracks[i] = MaTrack();
+			tracks[i].label = string::f("Track %d", i + 1);
+		}
+		tracksUsed      = MA_TRACKS;
+		editTrack       = 0;
+		stepsPerQuarter = 4.f;
+	}
+
+	// --- 全局查询 -------------------------------------------------------
+	int totalNotes() const {
+		int n = 0;
+		for (int i = 0; i < MA_TRACKS; ++i)
+			n += int(tracks[i].notes.size());
+		return n;
+	}
+
+	// 整首歌的长度 = 最长那条轨（也是走带一圈的格数）
+	int songSteps() const {
+		int m = 1;
+		for (int i = 0; i < MA_TRACKS; ++i)
+			if (tracks[i].measures > m)
+				m = tracks[i].measures;
+		if (m < 1) m = 1;
+		if (m > MA_MAX_MEASURES) m = MA_MAX_MEASURES;
+		return m * MA_STEPS_PER_MEASURE;
+	}
+
+	int longestMeasures() const { return songSteps() / MA_STEPS_PER_MEASURE; }
+
+	void clearAll() {
+		for (int i = 0; i < MA_TRACKS; ++i)
+			tracks[i].notes.clear();
+	}
+
+	// 回灌 / 写回用的统一入口：读当前步某轨某层的值（0..1 归一化）
+	float readLayerNorm(const int track, const int layer, const int step) const {
+		if (track < 0 || track >= MA_TRACKS)
+			return 0.f;
+
+		const int idx = tracks[track].indexSounding(step);
+		if (idx < 0)
+			return 0.f;   // 没有音符 → 0（旋钮拧到 0 位）
+
+		const MaNote& n = tracks[track].notes[size_t(idx)];
+		switch (layer) {
+			case MA_LAYER_PITCH:
+				return float(n.pitch - MA_PITCH_MIN) / float(MA_PITCH_MAX - MA_PITCH_MIN);
+			case MA_LAYER_LENGTH:
+				return float(n.length - 1) / float(MA_MAX_LENGTH - 1);
+			case MA_LAYER_VELOCITY:
+			default:
+				return n.velocity;
+		}
+	}
+
+	// 写回：把归一化值写进当前步某轨某层（没有音符就创建一个）
+	void writeLayerNorm(const int track, const int layer, const int step,
+	                    const float norm, const int defaultPitch) {
+		if (track < 0 || track >= MA_TRACKS)
+			return;
+
+		const float v = (norm < 0.f) ? 0.f : ((norm > 1.f) ? 1.f : norm);
+		const int idx = tracks[track].ensureNoteAt(step, defaultPitch);
+		if (idx < 0)
+			return;
+
+		MaNote& n = tracks[track].notes[size_t(idx)];
+		switch (layer) {
+			case MA_LAYER_PITCH:
+				n.pitch = MA_PITCH_MIN + int(std::round(v * float(MA_PITCH_MAX - MA_PITCH_MIN)));
+				break;
+			case MA_LAYER_LENGTH:
+				n.length = 1 + int(std::round(v * float(MA_MAX_LENGTH - 1)));
+				break;
+			case MA_LAYER_VELOCITY:
+			default:
+				n.velocity = v;
+				break;
+		}
+		n.clampValues();
+	}
+
+	// --- 存取 -----------------------------------------------------------
+	json_t* toJson() const {
+		json_t* const root = json_object();
+		json_object_set_new(root, "editTrack",       json_integer(editTrack));
+		json_object_set_new(root, "stepsPerQuarter", json_real(stepsPerQuarter));
+
+		json_t* const arr = json_array();
+		for (int i = 0; i < MA_TRACKS; ++i)
+			json_array_append_new(arr, tracks[i].toJson());
+		json_object_set_new(root, "tracks", arr);
+		return root;
+	}
+
+	void fromJson(json_t* const root) {
+		if (root == nullptr)
+			return;
+
+		json_t* j = json_object_get(root, "editTrack");
+		if (j != nullptr) editTrack = int(json_integer_value(j));
+		j = json_object_get(root, "stepsPerQuarter");
+		if (j != nullptr) stepsPerQuarter = float(json_real_value(j));
+
+		json_t* const arr = json_object_get(root, "tracks");
+		if (arr != nullptr) {
+			size_t idx;
+			json_t* t;
+			json_array_foreach(arr, idx, t) {
+				if (idx < size_t(MA_TRACKS))
+					tracks[idx].fromJson(t);
+			}
+		}
+
+		if (editTrack < 0) editTrack = 0;
+		if (editTrack >= MA_TRACKS) editTrack = MA_TRACKS - 1;
+	}
+};
+
+// ---------------------------------------------------------------------------
+// 小工具：面板要显示音名（CVfunk 的做法，见 §14.3 #11）
+// ---------------------------------------------------------------------------
+inline std::string noteNameOf(const int pitch) {
+	static const char* names[12] = {"C", "C#", "D", "D#", "E", "F",
+	                                "F#", "G", "G#", "A", "A#", "B"};
+	int p = pitch;
+	if (p < 0) p = 0;
+	const int oct  = p / 12 - 1;
+	const int semi = p % 12;
+	return string::f("%s%d", names[semi], oct);
+}
+
+// ---------------------------------------------------------------------------
+// UI 只读快照
+//   为什么需要：面板要画总览、要导出剪贴板，都得读「音符列表」，而音符列表是
+//   std::vector —— 音频线程在改。跨线程直接读 vector 是未定义行为（重新分配时
+//   可能撞上野指针），所以音频线程在数据变化时把音符拷进这块**定长 POD 数组**，
+//   UI 线程只读它。代价：每轨最多快照 MA_MAX_NOTES 个音符，超出的不显示也不导出。
+// ---------------------------------------------------------------------------
+static const int MA_MAX_NOTES = 512;
+
+struct MaSnapNote {
+	int16_t step     = 0;
+	int16_t length   = 1;
+	int16_t pitch    = 60;
+	float   velocity = 0.8f;
+};
+
+// ---------------------------------------------------------------------------
+// 主模块 <-> 扩展器 的消息协议
+//
+// Rack 的扩展器是「双缓冲指针交换」：两边各准备一块 float 数组，写完置
+// messageFlipRequested，引擎在时间步末尾把 producer / consumer 换过来。
+// 零拷贝，但有 **1 个时间步的延迟**（不是 1 个采样的延迟）。
+//
+// 四条硬约束：
+//   1. 两边数组长度必须一致 —— 对方会直接往「我的 producerMessage」那块内存写
+//   2. 延迟是「时间步」级的，所以步号这类离散量必须显式传过去，不能靠
+//      「把时钟边沿传过去、对方自己步进」—— 边沿会在时间步里被吞掉
+//   3. 不缓存对面的指针（Rack 2.4.1 删邻居模块时 onExpanderChange 不触发，
+//      缓存下来的指针会变野指针，见 PROJECT2-SPEC 11.3）
+//   4. 不走「扩展器转发时钟」这条路 —— 走带状态由主模块算好直接发
+// ---------------------------------------------------------------------------
+static const int MA_MSG_EVENTS    = 16;  // 一个时间步内最多带几条键盘事件
+static const int MA_MSG_EV_STRIDE = 5;   // 每条事件占几个 float
+static const int MA_MSG_SIZE      = 8 + MA_MSG_EVENTS * MA_MSG_EV_STRIDE;
+
+enum MaMsgIndex {
+	MA_MSG_STEP       = 0,  // 主模块当前步（扩展器直接跟随，不自己步进）
+	MA_MSG_LOOP       = 1,  // 一圈多少步
+	MA_MSG_RUN        = 2,  // 走带中
+	MA_MSG_REC        = 3,  // 录音中
+	MA_MSG_NCHAN      = 4,  // 键盘 VOCT 的声道数（复音阶梯用）
+	MA_MSG_EVCOUNT    = 5,  // 本次带了几条事件
+	MA_MSG_TOTALNOTES = 6,  // 扩展器回传：我这边有多少音符
+	MA_MSG_RESERVED   = 7,
+	MA_MSG_EV_BASE    = 8   // 事件区起点
+};
+
+enum MaMsgEventType {
+	MA_EV_NONE     = 0,
+	MA_EV_NOTE_ON  = 1,  // step = 起始步；pitch / velocity 有意义
+	MA_EV_NOTE_OFF = 2   // step = 结束步（不含）；length = step - onStep
+};
+
+// ---------------------------------------------------------------------------
+// 共用小部件：智能旋钮
+//   拖拽时置 isEditing 标志，告诉 DSP「手正在拧，别用回灌覆盖我」。
+//   从 ParamQuantity 反查模块与索引，所以接哪个旋钮都不用额外传参。
+//   主模块与扩展器共用本模板，靠 ModuleT 区分（两者的 VALUE1_PARAM 与
+//   isEditing 命名一致，这是刻意的）。
+// ---------------------------------------------------------------------------
+template <typename BaseKnob, typename ModuleT>
+struct StarseaSmartKnob : BaseKnob {
+	using BaseKnob::BaseKnob;
+
+	ModuleT* targetModule() {
+		ParamQuantity* const pq = this->getParamQuantity();
+		if (pq == nullptr)
+			return nullptr;
+		return dynamic_cast<ModuleT*>(pq->module);
+	}
+
+	int targetIndex() {
+		ParamQuantity* const pq = this->getParamQuantity();
+		if (pq == nullptr)
+			return -1;
+		const int idx = pq->paramId - ModuleT::VALUE1_PARAM;
+		return (idx >= 0 && idx < MA_TRACKS) ? idx : -1;
+	}
+
+	void onDragStart(const event::DragStart& e) override {
+		ModuleT* const m = targetModule();
+		const int idx = targetIndex();
+		if (m != nullptr && idx >= 0)
+			m->isEditing[idx].store(true);
+		BaseKnob::onDragStart(e);
+	}
+
+	void onDragEnd(const event::DragEnd& e) override {
+		ModuleT* const m = targetModule();
+		const int idx = targetIndex();
+		if (m != nullptr && idx >= 0)
+			m->isEditing[idx].store(false);
+		BaseKnob::onDragEnd(e);
+	}
+};
+
+} // namespace StarseaArranger
