+// 注册（还要在 plugin.hpp 加 extern 声明、在 plugins.cpp 的
+// initStatic__Starsea() 里 addModel）
+// ---------------------------------------------------------------------------
+Model* modelStarseaMiniArranger =
+	createModel<StarseaMiniArrangerModule, StarseaMiniArrangerWidget>("Starsea-MiniArranger");
