+/*
+ * Starsea plugin for Cardinal
+ * Module: MiniArrangerExpander - 给 MiniArranger 再加 4 条轨
+ *
+ * 为什么是扩展器
+ * --------------
+ * 「轨数越大越好」的正解不是把主面板做宽，而是主模块管 4 轨、每接一块扩展器
+ * 再加 4 轨 —— 面板永不失控（2026-09-21 李拍板）。
+ *
+ * 数据放哪
+ * --------
+ * 乙案：数据分散在各块。每块扩展器持有自己那 4 轨的音符，主模块只管发
+ *       「走带状态 + 键盘事件」。好处：拔掉扩展器，它那 4 轨跟着走，主模块不受影响。
+ *
+ * 怎么通信
+ * --------
+ * 走 Rack 的扩展器双缓冲消息（leftExpander / rightExpander），零拷贝，
+ * 1 个时间步延迟。协议见 ArrangerData.hpp 的 MaMsgIndex。
+ * ⚠️ 不通过消息传时钟边沿 —— 延迟是「时间步」级的，边沿会被吞掉。
+ *    主模块把「当前步号」直接发过来，本模块跟随，不自己步进。
+ * ⚠️ 不缓存 leftExpander.module 指针，每帧重取并校验 model
+ *    （Rack 2.4.1 删邻居模块时 onExpanderChange 不触发）。
+ *
+ * 面板（24HP = 121.92mm x 128.5mm）
+ * --------------------------------
+ *   左：4 轨 x 3 口输出（VOCT / GATE / VEL）
+ *   右：4 个编辑旋钮（2x2）+ TRACK / LAYER 选择 + 3 个状态灯
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "plugin.hpp"
+#include "ArrangerData.hpp"
+
+#include <atomic>
+
+namespace MA = StarseaArranger;
+
+// 录制最多跟踪几个复音声道
+static const int MAE_REC_CHAN = MA::MA_TRACKS;
+
+struct StarseaMiniArrangerExpander : Module {
+	enum ParamIds {
+		VALUE1_PARAM,        // 每轨当前步的值（0..1 归一化）
+		VALUE2_PARAM,
+		VALUE3_PARAM,
+		VALUE4_PARAM,
+		TRACK_EDIT_PARAM,    // 编辑 / 录制落在自己哪条轨
+		LAYER_PARAM,         // 编辑哪个字段：PITCH / LENGTH / VELOCITY
+		NUM_PARAMS
+	};
+	enum OutputIds {
+		TRACK1_VOCT_OUTPUT, TRACK1_GATE_OUTPUT, TRACK1_VEL_OUTPUT,
+		TRACK2_VOCT_OUTPUT, TRACK2_GATE_OUTPUT, TRACK2_VEL_OUTPUT,
+		TRACK3_VOCT_OUTPUT, TRACK3_GATE_OUTPUT, TRACK3_VEL_OUTPUT,
+		TRACK4_VOCT_OUTPUT, TRACK4_GATE_OUTPUT, TRACK4_VEL_OUTPUT,
+		NUM_OUTPUTS
+	};
+	enum LightIds {
+		LINK_LIGHT,     // 左边接上主模块了
+		RUN_LIGHT,      // 主模块在走带
+		RECORD_LIGHT,   // 主模块在录音
+		NUM_LIGHTS
+	};
+
+	// ---- 数据：本块自己那 4 轨 ----
+	MA::MaUnit unit;
+
+	// ---- 扩展器消息缓冲（长度必须与主模块一致；母模块会往 producer 里写）----
+	float leftMessages[2][MA::MA_MSG_SIZE] = {{0.f}};
+
+	// ---- 从主模块收到的走带状态 ----
+	int  remoteStep  = 0;
+	int  remoteLoop  = MA::MA_STEPS_PER_MEASURE * 4;
+	bool remoteRun   = false;
+	bool remoteRec   = false;
+	int  remoteNChan = 1;
+	bool linked      = false;
+
+	// ---- 录制跟踪（按声道，与主模块同名同义）----
+	bool  recActive[MAE_REC_CHAN] = {false};
+	int   recStep[MAE_REC_CHAN]   = {0};
+	int   recPitch[MAE_REC_CHAN]  = {60};
+	float recVel[MAE_REC_CHAN]    = {0.8f};
+
+	// ---- 编辑竞态 ----
+	alignas(std::atomic<bool>) std::atomic<bool> isEditing[MA::MA_TRACKS];
+	float lastKnobValue[MA::MA_TRACKS] = {0.f};
+
+	// ---- 给 UI 的快照 ----
+	std::atomic<int>   snapStep{0};
+	std::atomic<int>   snapLayer{0};
+	std::atomic<int>   snapEditTrack{0};
+	std::atomic<int>   snapTotalNotes{0};
+	std::atomic<bool>  snapHasNote[MA::MA_TRACKS];
+	std::atomic<int>   snapPitch[MA::MA_TRACKS];
+	std::atomic<int>   snapLength[MA::MA_TRACKS];
+	std::atomic<float> snapVel[MA::MA_TRACKS];
+	std::atomic<bool>  snapLinked{false};
+	std::atomic<bool>  snapRun{false};
+	std::atomic<bool>  snapRec{false};
+
+	// ---- 内部 ----
+	bool  dirty = true;
+	int   lastStep = -1;
+	int   lastLoop = -1;
+	int   lastEditTrack = -1;
+	int   lastLayer = -1;
+	float outVoct[MA::MA_TRACKS] = {0.f};
+	float outGate[MA::MA_TRACKS] = {0.f};
+	float outVel[MA::MA_TRACKS]  = {0.f};
+
+	StarseaMiniArrangerExpander() {
+		config(NUM_PARAMS, 0, NUM_OUTPUTS, NUM_LIGHTS);
+
+		// 消息缓冲挂到 leftExpander（母模块在左边）
+		leftExpander.producerMessage = leftMessages[0];
+		leftExpander.consumerMessage = leftMessages[1];
+		for (int i = 0; i < MA::MA_MSG_SIZE; ++i) {
+			leftMessages[0][i] = 0.f;
+			leftMessages[1][i] = 0.f;
+		}
+
+		for (int i = 0; i < MA::MA_TRACKS; ++i) {
+			configParam(VALUE1_PARAM + i, 0.f, 1.f, 0.f,
+			            string::f("Track %d value", i + 1));
+			isEditing[i].store(false);
+			snapHasNote[i].store(false);
+			snapPitch[i].store(-1);
+			snapLength[i].store(0);
+			snapVel[i].store(0.f);
+
+			configOutput(TRACK1_VOCT_OUTPUT + i * 3, string::f("Track %d V/Oct", i + 1));
+			configOutput(TRACK1_GATE_OUTPUT + i * 3, string::f("Track %d gate", i + 1));
+			configOutput(TRACK1_VEL_OUTPUT  + i * 3, string::f("Track %d velocity", i + 1));
+		}
+
+		configSwitch(TRACK_EDIT_PARAM, 0.f, float(MA::MA_TRACKS - 1), 0.f,
+		             "Edit / record track", {"1", "2", "3", "4"});
+		configSwitch(LAYER_PARAM, 0.f, float(MA::MA_NUM_LAYERS - 1), 0.f,
+		             "Edit layer", {"PITCH", "LENGTH", "VELOCITY"});
+
+		// 轨名带 E 前缀，跟主模块的 1-4 区分开
+		for (int i = 0; i < MA::MA_TRACKS; ++i)
+			unit.tracks[i].label = string::f("E%d", i + 1);
+	}
+
+	// -----------------------------------------------------------------------
+	// 工具
+	// -----------------------------------------------------------------------
+	// 复音阶梯：单声道线 -> 录到面板选的轨；多声道线 -> 第 c 声道录第 c 轨
+	// （与主模块 recTrackFor 同一套规则）
+	int recTrackFor(const int c) const {
+		if (remoteNChan <= 1)
+			return clamp(unit.editTrack, 0, MA::MA_TRACKS - 1);
+		return clamp(c, 0, MA::MA_TRACKS - 1);
+	}
+
+	// 吃一条主模块发来的键盘事件
+	void applyRemoteEvent(const int type, const int chan, const int pitch,
+	                      const float vel, const int step) {
+		const int c = clamp(chan, 0, MAE_REC_CHAN - 1);
+
+		if (!remoteRec) {
+			recActive[c] = false;
+			return;
+		}
+
+		if (type == MA::MA_EV_NOTE_ON) {
+			recActive[c] = true;
+			recStep[c]   = step;
+			recPitch[c]  = pitch;
+			recVel[c]    = clamp(vel, 0.f, 1.f);
+		} else if (type == MA::MA_EV_NOTE_OFF) {
+			if (!recActive[c])
+				return;
+
+			int len = step - recStep[c];
+			if (len < 1) len = 1;
+
+			MA::MaNote n;
+			n.step     = recStep[c];
+			n.length   = len;
+			n.pitch    = recPitch[c];
+			n.velocity = recVel[c];
+			n.clampValues();
+
+			const int track = recTrackFor(c);
+			unit.tracks[track].clearAt(n.step);
+			unit.tracks[track].pushNote(n);
+			unit.tracks[track].sortNotes();
+
+			recActive[c] = false;
+			dirty = true;
+		}
+	}
+
+	// -----------------------------------------------------------------------
+	// 输出 / 快照
+	// -----------------------------------------------------------------------
+	void refreshOutputs() {
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			const int idx = unit.tracks[t].indexSounding(remoteStep);
+			if (idx >= 0 && !unit.tracks[t].mute) {
+				const MA::MaNote& n = unit.tracks[t].notes[size_t(idx)];
+				outVoct[t] = float(n.pitch - 60) / 12.f;
+				outGate[t] = 10.f;
+				outVel[t]  = n.velocity * 10.f;
+			} else {
+				// 与主模块一致：门关了但音高不断，免得外部 VCO 每次跳音
+				outGate[t] = 0.f;
+				outVel[t]  = 0.f;
+			}
+		}
+	}
+
+	void updateSnapshot() {
+		snapStep.store(remoteStep);
+		snapLayer.store(clamp(int(std::round(params[LAYER_PARAM].getValue())),
+		                      0, MA::MA_NUM_LAYERS - 1));
+		snapEditTrack.store(unit.editTrack);
+		snapTotalNotes.store(unit.totalNotes());
+		snapLinked.store(linked);
+		snapRun.store(remoteRun);
+		snapRec.store(remoteRec);
+
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			const int idx = unit.tracks[t].indexSounding(remoteStep);
+			if (idx >= 0) {
+				const MA::MaNote& n = unit.tracks[t].notes[size_t(idx)];
+				snapHasNote[t].store(true);
+				snapPitch[t].store(n.pitch);
+				snapLength[t].store(n.length);
+				snapVel[t].store(n.velocity);
+			} else {
+				snapHasNote[t].store(false);
+				snapPitch[t].store(-1);
+				snapLength[t].store(0);
+				snapVel[t].store(0.f);
+			}
+		}
+	}
+
+	// -----------------------------------------------------------------------
+	// 主循环
+	// -----------------------------------------------------------------------
+	void process(const ProcessArgs& args) override {
+		// ---------- 1. 从主模块收消息 ----------
+		// 每帧重取指针 + 校验 model（不缓存）
+		const bool motherPresent = (leftExpander.module != nullptr) &&
+		                           (leftExpander.module->model == modelStarseaMiniArranger);
+		linked = motherPresent;
+
+		if (motherPresent) {
+			const float* const msg = (const float*)leftExpander.consumerMessage;
+			if (msg != nullptr) {
+				const int maxStep = MA::MA_MAX_MEASURES * MA::MA_STEPS_PER_MEASURE;
+				const int newStep = clamp(int(msg[MA::MA_MSG_STEP] + 0.5f), 0, maxStep - 1);
+				remoteLoop  = clamp(int(msg[MA::MA_MSG_LOOP] + 0.5f), 1, maxStep);
+				remoteRun   = msg[MA::MA_MSG_RUN] > 0.5f;
+				remoteRec   = msg[MA::MA_MSG_REC] > 0.5f;
+				remoteNChan = clamp(int(msg[MA::MA_MSG_NCHAN] + 0.5f), 1, MAE_REC_CHAN);
+
+				if (newStep != remoteStep) {
+					remoteStep = newStep;
+					dirty = true;   // 位置变了，输出与快照都要刷
+				}
+
+				const int evCount = clamp(int(msg[MA::MA_MSG_EVCOUNT] + 0.5f), 0, MA::MA_MSG_EVENTS);
+				for (int i = 0; i < evCount; ++i) {
+					const float* const e = &msg[MA::MA_MSG_EV_BASE + i * MA::MA_MSG_EV_STRIDE];
+					applyRemoteEvent(int(e[0] + 0.5f), int(e[1] + 0.5f),
+					                 int(e[2] + 0.5f), e[3], int(e[4] + 0.5f));
+				}
+			}
+
+			// 回传：我这边有多少音符（主模块面板会显示）
+			float* const toMother = (float*)leftExpander.module->rightExpander.producerMessage;
+			if (toMother != nullptr) {
+				toMother[MA::MA_MSG_TOTALNOTES] = float(unit.totalNotes());
+				leftExpander.module->rightExpander.messageFlipRequested = true;
+			}
+		} else {
+			// 主模块被拔了：手上按着的音符直接作废，别留下悬空的录音
+			for (int c = 0; c < MAE_REC_CHAN; ++c)
+				recActive[c] = false;
+			remoteRun = false;
+			remoteRec = false;
+			remoteStep = 0;
+		}
+
+		// ---------- 2. 面板开关落到数据层 ----------
+		unit.editTrack = clamp(int(std::round(params[TRACK_EDIT_PARAM].getValue())),
+		                       0, MA::MA_TRACKS - 1);
+		const int layer = clamp(int(std::round(params[LAYER_PARAM].getValue())),
+		                        0, MA::MA_NUM_LAYERS - 1);
+
+		// ---------- 3. 编辑：回灌 + 写回 ----------
+		const bool stepChanged = (remoteStep != lastStep) || (remoteLoop != lastLoop);
+		const bool trackChanged = (unit.editTrack != lastEditTrack);
+		const bool layerChanged = (layer != lastLayer);
+
+		if (stepChanged || trackChanged || layerChanged) {
+			for (int t = 0; t < MA::MA_TRACKS; ++t) {
+				if (isEditing[t].load())
+					continue;   // 正在拧，别覆盖
+				const float v = unit.readLayerNorm(t, layer, remoteStep);
+				params[VALUE1_PARAM + t].setValue(v);
+				lastKnobValue[t] = v;
+			}
+		}
+
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			const float v = params[VALUE1_PARAM + t].getValue();
+			if (std::fabs(v - lastKnobValue[t]) > 1e-6f) {
+				lastKnobValue[t] = v;
+				unit.writeLayerNorm(t, layer, remoteStep, v, 60);
+				dirty = true;
+			}
+		}
+
+		// ---------- 4. 数据或位置变了 -> 刷输出与快照 ----------
+		const bool dataChanged = dirty;
+		if (dirty) {
+			dirty = false;
+			refreshOutputs();
+			updateSnapshot();
+		}
+
+		lastStep = remoteStep;
+		lastLoop = remoteLoop;
+		lastEditTrack = unit.editTrack;
+		lastLayer = layer;
+
+		// ---------- 5. 输出 ----------
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			outputs[TRACK1_VOCT_OUTPUT + t * 3].setVoltage(outVoct[t]);
+			outputs[TRACK1_GATE_OUTPUT + t * 3].setVoltage(outGate[t]);
+			outputs[TRACK1_VEL_OUTPUT  + t * 3].setVoltage(outVel[t]);
+		}
+
+		// ---------- 6. 灯 ----------
+		lights[LINK_LIGHT].setBrightness(motherPresent ? 1.f : 0.f);
+		lights[RUN_LIGHT].setBrightness(remoteRun ? 1.f : 0.f);
+		lights[RECORD_LIGHT].setBrightness(remoteRec ? 1.f : 0.f);
+	}
+
+	json_t* dataToJson() override {
+		json_t* const root = json_object();
+		json_object_set_new(root, "arranger", unit.toJson());
+		return root;
+	}
+
+	void dataFromJson(json_t* const rootJ) override {
+		if (rootJ == nullptr)
+			return;
+
+		json_t* const a = json_object_get(rootJ, "arranger");
+		if (a != nullptr)
+			unit.fromJson(a);
+
+		for (int i = 0; i < MA::MA_TRACKS; ++i)
+			unit.tracks[i].label = string::f("E%d", i + 1);
+
+		dirty = true;
+		lastStep = -1;        // 强制下一帧回灌
+		lastEditTrack = -1;
+		lastLayer = -1;
+	}
+};
+
+// ---------------------------------------------------------------------------
+// 面板
+//
+// 坐标单位 = mm（与 res/MiniArrangerExpander.svg 同一坐标系）。
+// 面板 121.92mm = 24HP x 128.5mm。
+//
+//   x 6-70    输出区：4 列（每轨一列）x 3 行（VOCT / GATE / VEL）
+//   x 78-118  编辑区：4 个编辑旋钮（2 x 2）+ TRACK / LAYER
+// ---------------------------------------------------------------------------
+struct StarseaMiniArrangerExpanderWidget : ModuleWidget {
+	// 输出口
+	static constexpr float OUT_X0 = 20.f, OUT_DX = 14.f;
+	static constexpr float OUT_Y0 = 44.f, OUT_DY = 16.f;
+	// 编辑旋钮（2 列 x 2 行）
+	static constexpr float EDIT_X0 = 88.f, EDIT_DX = 18.f;
+	static constexpr float EDIT_Y0 = 50.f, EDIT_DY = 28.f;
+
+	StarseaMiniArrangerExpanderWidget(StarseaMiniArrangerExpander* module) {
+		setModule(module);
+		setPanel(APP->window->loadSvg(asset::plugin(pluginInstance, "res/MiniArrangerExpander.svg")));
+
+		addChild(createWidget<ScrewSilver>(Vec(RACK_GRID_WIDTH, 0)));
+		addChild(createWidget<ScrewSilver>(Vec(box.size.x - 2 * RACK_GRID_WIDTH, 0)));
+		addChild(createWidget<ScrewSilver>(Vec(RACK_GRID_WIDTH, RACK_GRID_HEIGHT - RACK_GRID_WIDTH)));
+		addChild(createWidget<ScrewSilver>(Vec(box.size.x - 2 * RACK_GRID_WIDTH, RACK_GRID_HEIGHT - RACK_GRID_WIDTH)));
+
+		// ---- 每轨 3 个输出口 + 4 个编辑旋钮 ----
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			for (int o = 0; o < 3; ++o)
+				addOutput(createOutputCentered<PJ301MPort>(
+					mm2px(Vec(OUT_X0 + t * OUT_DX, OUT_Y0 + o * OUT_DY)),
+					module,
+					StarseaMiniArrangerExpander::TRACK1_VOCT_OUTPUT + t * 3 + o));
+
+			const float mx = EDIT_X0 + (t % 2) * EDIT_DX;
+			const float my = EDIT_Y0 + (t / 2) * EDIT_DY;
+			addParam(createParamCentered<MA::StarseaSmartKnob<RoundBlackKnob, StarseaMiniArrangerExpander>>(
+				mm2px(Vec(mx, my)), module, StarseaMiniArrangerExpander::VALUE1_PARAM + t));
+		}
+
+		// ---- 轨选择 / 层选择 ----
+		addParam(createParamCentered<RoundBlackSnapKnob>(mm2px(Vec(EDIT_X0, 106.f)),
+		                                                 module, StarseaMiniArrangerExpander::TRACK_EDIT_PARAM));
+		addParam(createParamCentered<RoundBlackSnapKnob>(mm2px(Vec(EDIT_X0 + EDIT_DX, 106.f)),
+		                                                 module, StarseaMiniArrangerExpander::LAYER_PARAM));
+
+		// ---- 状态灯 ----
+		addChild(createLightCentered<SmallLight<GreenLight>>(mm2px(Vec(36.f, 15.f)),
+		                                                     module, StarseaMiniArrangerExpander::LINK_LIGHT));
+		addChild(createLightCentered<SmallLight<GreenLight>>(mm2px(Vec(60.f, 15.f)),
+		                                                     module, StarseaMiniArrangerExpander::RUN_LIGHT));
+		addChild(createLightCentered<SmallLight<RedLight>>(mm2px(Vec(84.f, 15.f)),
+		                                                   module, StarseaMiniArrangerExpander::RECORD_LIGHT));
+	}
+
+	void draw(const DrawArgs& args) override {
+		ModuleWidget::draw(args);
+
+		std::shared_ptr<Font> font = APP->window->loadFont(asset::system("res/fonts/ShareTechMono-Regular.ttf"));
+		if (font)
+			nvgFontFaceId(args.vg, font->handle);
+		nvgTextLetterSpacing(args.vg, 0.f);
+
+		const auto put = [&](const float x, const float y, const float size,
+		                     const int align, const NVGcolor col, const char* txt) {
+			nvgFontSize(args.vg, size);
+			nvgTextAlign(args.vg, align | NVG_ALIGN_MIDDLE);
+			nvgFillColor(args.vg, col);
+			nvgText(args.vg, mm2px(x), mm2px(y), txt, NULL);
+		};
+
+		const NVGcolor cWarm = nvgRGB(0x9f, 0xd8, 0xf0);
+		const NVGcolor cDim  = nvgRGB(0x6c, 0x7f, 0x90);
+		const NVGcolor cHot  = nvgRGB(0xf0, 0xc0, 0x70);
+		const NVGcolor cPale = nvgRGB(0xd8, 0xe4, 0xec);
+
+		const NVGcolor trackCol[MA::MA_TRACKS] = {
+			nvgRGB(0x5f, 0xd0, 0xc8),
+			nvgRGB(0xf0, 0xb0, 0x60),
+			nvgRGB(0x8f, 0xd0, 0x70),
+			nvgRGB(0xb8, 0x9c, 0xe8)
+		};
+
+		// ---- 标题 / 灯标 ----
+		put(61.f, 8.f, 10.f, NVG_ALIGN_CENTER, nvgRGB(0x0e, 0x12, 0x16), "MINI ARRANGER EXP");
+		put(40.f, 15.f, 5.5f, NVG_ALIGN_LEFT, cDim, "LINK");
+		put(64.f, 15.f, 5.5f, NVG_ALIGN_LEFT, cDim, "RUN");
+		put(88.f, 15.f, 5.5f, NVG_ALIGN_LEFT, cDim, "REC");
+
+		// ---- 分区标题 ----
+		put(41.f, 27.f, 8.f, NVG_ALIGN_CENTER, cWarm, "OUT");
+		put(98.f, 27.f, 8.f, NVG_ALIGN_CENTER, cWarm, "EDIT");
+
+		// ---- 输出区：列号 + 行标签 ----
+		for (int t = 0; t < MA::MA_TRACKS; ++t)
+			put(OUT_X0 + t * OUT_DX, 35.f, 7.f, NVG_ALIGN_CENTER, trackCol[t],
+			    string::f("%d", t + 1).c_str());
+
+		const char* rowNames[3] = {"VOCT", "GATE", "VEL"};
+		for (int o = 0; o < 3; ++o)
+			put(13.f, OUT_Y0 + o * OUT_DY, 6.f, NVG_ALIGN_RIGHT, cDim, rowNames[o]);
+
+		StarseaMiniArrangerExpander* const m =
+			dynamic_cast<StarseaMiniArrangerExpander*>(module);
+
+		// ---- 编辑区：轨号 + 当前值 ----
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			const float x = EDIT_X0 + (t % 2) * EDIT_DX;
+			const float y = EDIT_Y0 + (t / 2) * EDIT_DY;
+			put(x, y - 10.f, 7.f, NVG_ALIGN_CENTER, trackCol[t],
+			    string::f("TRK %d", t + 1).c_str());
+
+			if (m == nullptr) {
+				put(x, y + 11.f, 6.5f, NVG_ALIGN_CENTER, cDim, "--");
+				continue;
+			}
+
+			if (!m->snapHasNote[t].load()) {
+				put(x, y + 11.f, 6.5f, NVG_ALIGN_CENTER, cDim, "--");
+				continue;
+			}
+
+			const int lay = clamp(m->snapLayer.load(), 0, MA::MA_NUM_LAYERS - 1);
+			const int p = m->snapPitch[t].load();
+			const int l = m->snapLength[t].load();
+			const float vv = m->snapVel[t].load();
+			// 必须用 std::string 接住：string::f() 返回临时对象，存 .c_str() 会悬垂
+			std::string txt;
+			switch (lay) {
+				case MA::MA_LAYER_PITCH:  txt = MA::noteNameOf(p); break;
+				case MA::MA_LAYER_LENGTH: txt = string::f("%d", l); break;
+				default:                  txt = string::f("%.0f%%", vv * 100.f); break;
+			}
+			put(x, y + 11.f, 6.5f, NVG_ALIGN_CENTER, cPale, txt.c_str());
+		}
+
+		// ---- TRACK / LAYER 选择 ----
+		put(EDIT_X0, 97.f, 6.f, NVG_ALIGN_CENTER, cDim, "TRACK");
+		put(EDIT_X0 + EDIT_DX, 97.f, 6.f, NVG_ALIGN_CENTER, cDim, "LAYER");
+
+		if (m != nullptr) {
+			put(EDIT_X0, 117.f, 6.5f, NVG_ALIGN_CENTER, cHot,
+			    string::f("%d", m->snapEditTrack.load() + 1).c_str());
+			static const char* layerNames[MA::MA_NUM_LAYERS] = {"PITCH", "LENGTH", "VEL"};
+			put(EDIT_X0 + EDIT_DX, 117.f, 6.5f, NVG_ALIGN_CENTER, cHot,
+			    layerNames[clamp(m->snapLayer.load(), 0, MA::MA_NUM_LAYERS - 1)]);
+
+			// 底部状态：跟随 / 脱离 + 本块音符数
+			if (m->snapLinked.load()) {
+				put(61.f, 124.f, 6.f, NVG_ALIGN_CENTER, cWarm,
+				    string::f("%d NOTES", m->snapTotalNotes.load()).c_str());
+			} else {
+				put(61.f, 124.f, 6.f, NVG_ALIGN_CENTER, cDim, "NO MASTER");
+			}
+		}
+	}
+};
+
+// ---------------------------------------------------------------------------
+// 注册（还要在 plugin.hpp 加 extern 声明、在 plugins.cpp 的
+// initStatic__Starsea() 里 addModel）
+// ---------------------------------------------------------------------------
+Model* modelStarseaMiniArrangerExpander =
+	createModel<StarseaMiniArrangerExpander, StarseaMiniArrangerExpanderWidget>(
+		"Starsea-MiniArrangerExpander");
