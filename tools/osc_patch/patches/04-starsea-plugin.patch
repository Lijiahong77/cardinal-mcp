+
+	// -----------------------------------------------------------------------
+	// 工具
+	// -----------------------------------------------------------------------
+	static int pitchFromVoltage(const float v) {
+		int p = int(std::lround(v * 12.f)) + 60;
+		if (p < MA::MA_PITCH_MIN) p = MA::MA_PITCH_MIN;
+		if (p > MA::MA_PITCH_MAX) p = MA::MA_PITCH_MAX;
+		return p;
+	}
+
+	int recTrackFor(const int c, const int nChan) const {
+		if (nChan <= 1)
+			return clamp(unit.editTrack, 0, MA::MA_TRACKS - 1);
+		return clamp(c, 0, MA::MA_TRACKS - 1);
+	}
+
+	// 记一条「要发给扩展器」的键盘事件（音频线程调用）
+	void emitEvent(const int type, const int chan, const int pitch,
+	               const float vel, const int step) {
+		if (outEventCount >= MA::MA_MSG_EVENTS)
+			return;
+		float* const e = outEvents[outEventCount];
+		e[0] = float(type);
+		e[1] = float(chan);
+		e[2] = float(pitch);
+		e[3] = vel;
+		e[4] = float(step);
+		outEventCount++;
+	}
+
+	// -----------------------------------------------------------------------
+	// 录制
+	// -----------------------------------------------------------------------
+	void finishNote(const int c, const int endStep) {
+		if (!recActive[c])
+			return;
+
+		const int track = clamp(recTrack[c], 0, MA::MA_TRACKS - 1);
+
+		MA::MaNote n;
+		n.step = recStep[c];
+		n.length = (endStep > recStep[c]) ? (endStep - recStep[c]) : 1;
+		n.pitch = recPitch[c];
+		n.velocity = recVel[c];
+		n.clampValues();
+
+		// 同一位置先清干净，避免叠音（重录同一处 = 覆盖）
+		unit.tracks[track].clearAt(n.step);
+		unit.tracks[track].pushNote(n);
+		unit.tracks[track].sortNotes();
+
+		// 同一件事也告诉扩展器（它自己决定存进哪条轨）
+		emitEvent(MA::MA_EV_NOTE_OFF, c, recPitch[c], recVel[c], endStep);
+
+		recActive[c] = false;
+		dirty = true;
+	}
+
+	void finishAllRecordings(const int endStep) {
+		for (int c = 0; c < MA_REC_CHAN; ++c) {
+			if (recActive[c])
+				finishNote(c, endStep);
+		}
+	}
+
+	void doRecording() {
+		const int nChan = std::max(1, inputs[VOCT_INPUT].getChannels());
+		const int nUse  = std::min(nChan, MA_REC_CHAN);
+
+		for (int c = 0; c < nUse; ++c) {
+			const int track = recTrackFor(c, nUse);
+
+			const float g   = inputs[GATE_INPUT].getPolyVoltage(c);
+			const float v   = inputs[VOCT_INPUT].getPolyVoltage(c);
+			const float vel = inputs[VELOCITY_INPUT].isConnected()
+			                  ? inputs[VELOCITY_INPUT].getPolyVoltage(c) : 10.f;
+
+			const bool high = gateTrig[c].process(g);
+
+			if (high && !recActive[c]) {
+				// 音符开始
+				recActive[c] = true;
+				recStep[c]   = currentStep.load();
+				recPitch[c]  = pitchFromVoltage(v);
+				recTrack[c]  = track;
+				recVel[c]    = clamp(vel / 10.f, 0.f, 1.f);
+				emitEvent(MA::MA_EV_NOTE_ON, c, recPitch[c], recVel[c], recStep[c]);
+			} else if (!high && recActive[c]) {
+				// 音符结束 —— 按住几格就是几格
+				finishNote(c, currentStep.load() + 1);
+			} else if (high && recActive[c]) {
+				// 按住过程中允许改音高（滑音后停住 = 取最终音高）
+				recPitch[c] = pitchFromVoltage(v);
+				recVel[c]   = clamp(vel / 10.f, 0.f, 1.f);
+			}
+		}
+
+		// 声道数变少了：把多出来的收尾
+		for (int c = nUse; c < MA_REC_CHAN; ++c) {
+			if (recActive[c])
+				finishNote(c, currentStep.load() + 1);
+		}
+	}
+
+	// -----------------------------------------------------------------------
+	// 输出 / 快照
+	// -----------------------------------------------------------------------
+	void refreshOutputs() {
+		const int s = currentStep.load();
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			const int idx = unit.tracks[t].indexSounding(s);
+			if (idx >= 0 && !unit.tracks[t].mute) {
+				const MA::MaNote& n = unit.tracks[t].notes[size_t(idx)];
+				outVoct[t] = float(n.pitch - 60) / 12.f;
+				outGate[t] = 10.f;
+				outVel[t]  = n.velocity * 10.f;
+			} else {
+				// VOCT 刻意保持不变：门关了但音高不断，免得外部 VCO 每次跳音
+				outGate[t] = 0.f;
+				outVel[t]  = 0.f;
+			}
+		}
+	}
+
+	void rebuildOverview() {
+		const int steps = unit.songSteps();
+		snapSteps.store(steps);
+
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			uint8_t* row = overview[t];
+			for (int s = 0; s < steps; ++s)
+				row[s] = 0;
+
+			const MA::MaTrack& tr = unit.tracks[t];
+
+			// 顺手灌一份 UI 只读快照（导出剪贴板时用，避免跨线程读 vector）
+			int cnt = 0;
+			const int maxStep = MA::MA_MAX_MEASURES * MA::MA_STEPS_PER_MEASURE;
+			for (size_t i = 0; i < tr.notes.size() && cnt < MA::MA_MAX_NOTES; ++i) {
+				const MA::MaNote& n = tr.notes[i];
+				noteSnap[t][cnt].step     = int16_t(clamp(n.step, 0, maxStep - 1));
+				noteSnap[t][cnt].length   = int16_t(clamp(n.length, 1, MA::MA_MAX_LENGTH));
+				noteSnap[t][cnt].pitch    = int16_t(clamp(n.pitch, MA::MA_PITCH_MIN, MA::MA_PITCH_MAX));
+				noteSnap[t][cnt].velocity = n.velocity;
+				cnt++;
+			}
+			snapNoteCount[t].store(cnt);
+
+			for (size_t i = 0; i < tr.notes.size(); ++i) {
+				const MA::MaNote& n = tr.notes[i];
+				for (int k = 0; k < n.length; ++k) {
+					const int s = n.step + k;
+					if (s >= 0 && s < steps && s < maxStep)
+						row[s] = 1;
+				}
+			}
+		}
+	}
+
+	void updateSnapshot() {
+		const int s = currentStep.load();
+		snapStep.store(s);
+		snapEditTrack.store(unit.editTrack);
+		snapLayer.store(int(std::round(params[LAYER_PARAM].getValue())));
+		snapMeasures.store(unit.tracks[unit.editTrack].measures);
+		snapRunning.store(running);
+		snapRecording.store(recording);
+		snapTotalNotes.store(unit.totalNotes());
+
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			snapMute[t].store(unit.tracks[t].mute);
+			const int idx = unit.tracks[t].indexSounding(s);
+			if (idx >= 0) {
+				const MA::MaNote& n = unit.tracks[t].notes[size_t(idx)];
+				snapHasNote[t].store(true);
+				snapPitch[t].store(n.pitch);
+				snapLength[t].store(n.length);
+				snapVel[t].store(n.velocity);
+			} else {
+				snapHasNote[t].store(false);
+				snapPitch[t].store(-1);
+				snapLength[t].store(0);
+				snapVel[t].store(0.f);
+			}
+		}
+	}
+
+	// -----------------------------------------------------------------------
+	// 剪贴板导入 / 导出（都在 UI 线程调用，见 appendContextMenu）
+	// -----------------------------------------------------------------------
+	// 读剪贴板 -> 转成内部音符 -> 排队给音频线程落库。
+	// 返回音符数；-1 = 剪贴板不是 Portable Sequence；-2 = 格式对但一个音符都没有。
+	int uiImportToTrack(const int track) {
+		SPS::Sequence seq;
+		if (!seq.fromClipboard()) {
+			importFlash.store(4.f);
+			importFlashCount.store(-1);
+			return -1;
+		}
+		if (seq.notes.empty()) {
+			importFlash.store(4.f);
+			importFlashCount.store(-2);
+			return -2;
+		}
+
+		const double spq = double(unit.stepsPerQuarter > 0.f ? unit.stepsPerQuarter : 4.f);
+		std::vector<MA::MaNote> notes;
+		notes.reserve(seq.notes.size());
+		for (size_t i = 0; i < seq.notes.size(); ++i) {
+			const SPS::Note& pn = seq.notes[i];
+			MA::MaNote n;
+			n.step     = int(std::lround(double(pn.start) * spq));
+			n.length   = int(std::lround(double(pn.length) * spq));
+			n.pitch    = int(std::lround(double(pn.pitch) * 12.0)) + 60;
+			n.velocity = (pn.velocity >= 0.f) ? (pn.velocity / 10.f) : 0.8f;
+			n.clampValues();
+			notes.push_back(n);
+		}
+
+		{
+			std::lock_guard<std::mutex> lock(importMutex);
+			importNotes.swap(notes);
+		}
+		importTarget.store(clamp(track, 0, MA::MA_TRACKS - 1));
+
+		importFlash.store(4.f);
+		importFlashCount.store(int(seq.notes.size()));
+		return int(seq.notes.size());
+	}
+
+	// 把某轨快照写成 Portable Sequence 放剪贴板
+	bool uiExportTrack(const int track) {
+		if (track < 0 || track >= MA::MA_TRACKS)
+			return false;
+
+		const double spq = double(unit.stepsPerQuarter > 0.f ? unit.stepsPerQuarter : 4.f);
+		SPS::Sequence seq;
+		const int cnt = clamp(snapNoteCount[track].load(), 0, MA::MA_MAX_NOTES);
+		for (int i = 0; i < cnt; ++i) {
+			const MA::MaSnapNote& s = noteSnap[track][i];
+			SPS::Note pn;
+			pn.start    = float(double(s.step) / spq);
+			pn.pitch    = float((double(s.pitch) - 60.0) / 12.0);
+			pn.length   = float(double(s.length) / spq);
+			pn.velocity = s.velocity * 10.f;
+			seq.addNote(pn);
+		}
+		seq.length = double(unit.songSteps()) / spq;
+		seq.sort();
+
+		const bool ok = seq.toClipboard();
+		importFlash.store(4.f);
+		importFlashCount.store(ok ? cnt : -3);
+		return ok;
+	}
+
+	void requestClearAll() {
+		clearRequest.store(true);
+	}
+
+	// -----------------------------------------------------------------------
+	// 主循环
+	// -----------------------------------------------------------------------
+	void process(const ProcessArgs& args) override {
+		// ---------- 0. 消费 UI 线程的请求 ----------
+		const int importTo = importTarget.exchange(-1);
+		if (importTo >= 0) {
+			std::vector<MA::MaNote> incoming;
+			{
+				std::lock_guard<std::mutex> lock(importMutex);
+				incoming.swap(importNotes);
+			}
+			const int track = clamp(importTo, 0, MA::MA_TRACKS - 1);
+			MA::MaTrack& tr = unit.tracks[track];
+			tr.notes.clear();                       // 导入 = 替换该轨，不是叠加
+			for (size_t i = 0; i < incoming.size(); ++i)
+				tr.pushNote(incoming[i]);
+			tr.sortNotes();
+			dirty = true;
+		}
+
+		if (clearRequest.exchange(false)) {
+			unit.clearAll();
+			dirty = true;
+		}
+
+		if (importFlash.load() > 0.f)
+			importFlash.store(std::max(0.f, importFlash.load() - args.sampleTime));
+
+		const int steps = unit.songSteps();
+		const int layer = clamp(int(std::round(params[LAYER_PARAM].getValue())), 0, MA::MA_NUM_LAYERS - 1);
+
+		// 面板开关落到数据层
+		// ⚠️ 必须检测「变化」：mute 只在 refreshOutputs()/updateSnapshot() 里生效，
+		//    而那两处只在 step/track/layer/data 变化时才跑 ⇒ 停止状态下拨 Mute
+		//    永远不刷新（门保持 10V 挂着，音一直响）。见下方 muteChanged 进刷新条件。
+		bool muteChanged = false;
+		for (int i = 0; i < MA::MA_TRACKS; ++i) {
+			const bool m = params[MUTE1_PARAM + i].getValue() > 0.5f;
+			if (m != unit.tracks[i].mute) {
+				unit.tracks[i].mute = m;
+				muteChanged = true;
+			}
+		}
+		unit.editTrack = clamp(int(std::round(params[TRACK_EDIT_PARAM].getValue())),
+		                       0, MA::MA_TRACKS - 1);
+
+		// ---------- 1. RUN / RECORD 翻转（按钮与输入各自检测边沿，再合并）----------
+		const bool runEdge = runButtonTrig.process(params[RUN_BUTTON_PARAM].getValue());
+		const bool runInEdge = runTrig.process(inputs[RUN_INPUT].getVoltage());
+		if (runEdge || runInEdge)
+			running = !running;
+
+		const bool recEdge = recButtonTrig.process(params[REC_BUTTON_PARAM].getValue());
+		const bool recInEdge = recTrig.process(inputs[RECORD_INPUT].getVoltage());
+		if (recEdge || recInEdge)
+			recording = !recording;
+
+		// ---------- 2. RESET：两段式（置标志，等下个时钟才真复位）----------
+		const bool resetEdge = resetTrig.process(inputs[RESET_INPUT].getVoltage());
+		if (resetEdge)
+			resetPending = true;
+
+		// ---------- 3. 时钟步进 ----------
+		bool stepChanged = false;
+		const bool clockEdge = clockTrig.process(inputs[CLOCK_INPUT].getVoltage());
+		if (clockEdge && running) {
+			if (resetPending) {
+				resetPending = false;
+				finishAllRecordings(currentStep.load() + 1);
+				currentStep.store(0);
+			} else {
+				int nxt = currentStep.load() + 1;
+				if (nxt >= steps) {
+					nxt = 0;
+					eocPulse.trigger(0.001f);
+					finishAllRecordings(steps);   // 跨回卷：收到歌尾
+				}
+				currentStep.store(nxt);
+			}
+			stepChanged = true;
+		}
+
+		// 不跑的时候按 reset 就立即复位
+		if (resetPending && !running) {
+			resetPending = false;
+			finishAllRecordings(currentStep.load() + 1);
+			currentStep.store(0);
+			stepChanged = true;
+		}
+
+		// UI 点击跳步
+		const int jump = stepJump.exchange(-1);
+		if (jump >= 0) {
+			finishAllRecordings(currentStep.load() + 1);
+			currentStep.store(clamp(jump, 0, steps - 1));
+			stepChanged = true;
+		}
+
+		// ---------- 4. 录制 ----------
+		if (running && recording) {
+			doRecording();
+		} else if (!recording) {
+			// 退出录制：把手上按着的音符收尾，并清触发器状态
+			finishAllRecordings(currentStep.load() + 1);
+			for (int c = 0; c < MA_REC_CHAN; ++c)
+				gateTrig[c].reset();
+		}
+
+		// ---------- 5. 编辑：回灌 + 写回 ----------
+		const bool trackChanged = (unit.editTrack != lastEditTrack);
+		const bool layerChanged = (layer != lastLayer);
+		const bool needRecall = stepChanged || trackChanged || layerChanged;
+
+		// 5a. 回灌：把「当前步 + 当前层」的值送进旋钮
+		if (needRecall) {
+			for (int t = 0; t < MA::MA_TRACKS; ++t) {
+				if (isEditing[t].load())
+					continue;   // 正在拧，别覆盖
+				const float v = unit.readLayerNorm(t, layer, currentStep.load());
+				params[VALUE1_PARAM + t].setValue(v);
+				lastKnobValue[t] = v;
+			}
+			// STEP 旋钮位置跟随走带
+			const float sv = (steps > 1) ? float(currentStep.load()) / float(steps - 1) : 0.f;
+			params[STEP_PARAM].setValue(clamp(sv, 0.f, 1.f));
+			lastStepKnob = sv;
+		}
+
+		// 5a+. MEASURES 旋钮跟随当前编辑轨的小节数
+		if (trackChanged) {
+			const float mv = float(unit.tracks[unit.editTrack].measures);
+			params[TRACK_MEASURES_PARAM].setValue(mv);
+			lastMeasuresKnob = mv;
+		}
+
+		// 5b. STEP 旋钮被拧 -> 跳步
+		const float stepKnob = params[STEP_PARAM].getValue();
+		if (std::fabs(stepKnob - lastStepKnob) > 1e-6f) {
+			lastStepKnob = stepKnob;
+			const int want = int(std::lround(stepKnob * float(steps - 1)));
+			if (want != currentStep.load()) {
+				finishAllRecordings(currentStep.load() + 1);
+				currentStep.store(clamp(want, 0, steps - 1));
+				stepChanged = true;
+				updateSnapshot();
+				refreshOutputs();
+				// 跳步后立刻回灌一次，旋钮才不会和谱面对不上
+				for (int t = 0; t < MA::MA_TRACKS; ++t) {
+					if (isEditing[t].load())
+						continue;
+					const float v = unit.readLayerNorm(t, layer, currentStep.load());
+					params[VALUE1_PARAM + t].setValue(v);
+					lastKnobValue[t] = v;
+				}
+			}
+		}
+
+		// 5c. 写回：谁的值变了就写谁（覆盖拖拽与滚轮两种操作）
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			const float v = params[VALUE1_PARAM + t].getValue();
+			if (std::fabs(v - lastKnobValue[t]) > 1e-6f) {
+				lastKnobValue[t] = v;
+				unit.writeLayerNorm(t, layer, currentStep.load(), v, 60);
+				dirty = true;
+			}
+		}
+
+		// 5d. MEASURES 旋钮被拧 → 写回当前编辑轨的小节数
+		{
+			const float mv = params[TRACK_MEASURES_PARAM].getValue();
+			if (std::fabs(mv - lastMeasuresKnob) > 1e-6f) {
+				lastMeasuresKnob = mv;
+				const int bars = clamp(int(std::round(mv)), 1, 16);
+				if (bars != unit.tracks[unit.editTrack].measures) {
+					unit.tracks[unit.editTrack].measures = bars;
+					dirty = true;
+				}
+			}
+		}
+
+		// ---------- 6. 位置或数据变了 -> 刷新输出与快照 ----------
+		// 只在需要时扫音符，不每帧扫（1024 格 x 4 轨扫一遍不值得每帧做）
+		const bool dataChanged = dirty;
+		if (dirty) {
+			dirty = false;
+			rebuildOverview();
+		}
+		if (stepChanged || trackChanged || layerChanged || dataChanged || muteChanged) {
+			refreshOutputs();
+			updateSnapshot();
+		}
+
+		lastEditTrack = unit.editTrack;
+		lastLayer = layer;
+
+		// ---------- 7. 输出 ----------
+		// mute 在这里再判一次（不依赖 refreshOutputs 的时机）—— 这是「拨下开关立刻静音」的硬保证，
+		// 走带停着、没有任何 step 变化时也不会漏。VOCT 保持不变是刻意的：门关了但音高不断，
+		// 免得外部 VCO 每次跳音。
+		// 键盘直通（手弹优先）：外部键盘按住键时，把输入的 V/Oct / gate / velocity 直接送到
+		// 「当前编辑轨」(= TRACK 旋钮选的那一轨) 的输出口。于是不必等走带走到那一步，弹下去
+		// 立刻就有声音；松手立刻回到该轨的回放内容。静音的轨不直通（静音优先）。
+		// 每帧重算、不缓存 —— 所以不存在「门卡在 10V 不落」的风险（同 mute 那次的教训）。
+		const bool  thruDown  = inputs[GATE_INPUT].isConnected() &&
+		                        (inputs[GATE_INPUT].getVoltage() > 1.f);
+		const int   thruTrack = clamp(unit.editTrack, 0, MA::MA_TRACKS - 1);
+		const float thruVoct  = inputs[VOCT_INPUT].getVoltage();
+		const float thruVel   = inputs[VELOCITY_INPUT].isConnected()
+		                        ? inputs[VELOCITY_INPUT].getVoltage() : 10.f;
+
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			const bool muted = unit.tracks[t].mute;
+			const bool thru  = thruDown && (t == thruTrack) && !muted;
+			outputs[TRACK1_VOCT_OUTPUT + t * 3].setVoltage(thru ? thruVoct : outVoct[t]);
+			outputs[TRACK1_GATE_OUTPUT + t * 3].setVoltage(muted ? 0.f : (thru ? 10.f : outGate[t]));
+			outputs[TRACK1_VEL_OUTPUT  + t * 3].setVoltage(muted ? 0.f : (thru ? thruVel : outVel[t]));
+		}
+
+		// 试听口 = 「当前编辑轨」那一组的镜像（含手弹直通、静音判定）。
+		// 于是只需把一条 VCO+ADSR+VCA 链接到试听口，拧 TRACK 旋钮就能听任意轨。
+		// 同样每帧重算、不缓存（thruTrack 已经是 clamp 过的编辑轨号）。
+		{
+			const bool audMuted = unit.tracks[thruTrack].mute;
+			const bool audThru  = thruDown && !audMuted;
+			outputs[AUDITION_VOCT_OUTPUT].setVoltage(audThru ? thruVoct : outVoct[thruTrack]);
+			outputs[AUDITION_GATE_OUTPUT].setVoltage(audMuted ? 0.f : (audThru ? 10.f : outGate[thruTrack]));
+		}
+
+		// 共享转发（串接下一台编曲机用）
+		outputs[CLOCK_OUTPUT].setVoltage(inputs[CLOCK_INPUT].getVoltage());
+		outputs[RESET_OUTPUT].setVoltage(inputs[RESET_INPUT].getVoltage());
+		outputs[RUN_OUTPUT].setVoltage(inputs[RUN_INPUT].getVoltage());
+		outputs[RECORD_OUTPUT].setVoltage(inputs[RECORD_INPUT].getVoltage());
+		outputs[END_OF_SONG_OUTPUT].setVoltage(eocPulse.process(args.sampleTime) ? 10.f : 0.f);
+
+		// ---------- 8. 灯 ----------
+		lights[RUN_LIGHT].setBrightness(running ? 1.f : 0.f);
+		lights[RECORD_LIGHT].setBrightness(recording ? 1.f : 0.f);
+
+		// ---------- 9. 与右边的扩展器交换消息 ----------
+		// 每帧重取指针、用前判断 model —— 不缓存（Rack 2.4.1 删邻居不触发回调）
+		const bool expPresent = (rightExpander.module != nullptr) &&
+		                        (rightExpander.module->model == modelStarseaMiniArrangerExpander);
+		snapExpander.store(expPresent);
+
+		if (expPresent) {
+			float* const msg = (float*)(rightExpander.module->leftExpander.producerMessage);
+			if (msg != nullptr) {
+				msg[MA::MA_MSG_STEP]       = float(currentStep.load());
+				msg[MA::MA_MSG_LOOP]       = float(steps);
+				msg[MA::MA_MSG_RUN]        = running ? 1.f : 0.f;
+				msg[MA::MA_MSG_REC]        = recording ? 1.f : 0.f;
+				msg[MA::MA_MSG_NCHAN]      = float(std::max(1, inputs[VOCT_INPUT].getChannels()));
+				msg[MA::MA_MSG_EVCOUNT]    = float(outEventCount);
+				msg[MA::MA_MSG_TOTALNOTES] = float(unit.totalNotes());
+				const int n = std::min(outEventCount, MA::MA_MSG_EVENTS);
+				for (int i = 0; i < n; ++i)
+					for (int k = 0; k < MA::MA_MSG_EV_STRIDE; ++k)
+						msg[MA::MA_MSG_EV_BASE + i * MA::MA_MSG_EV_STRIDE + k] = outEvents[i][k];
+				rightExpander.module->leftExpander.messageFlipRequested = true;
+			}
+
+			// 读回扩展器那边的东西（只在确认接上时读指针）
+			const float* const back = (const float*)rightExpander.consumerMessage;
+			snapExpanderNotes.store(back != nullptr ? int(back[MA::MA_MSG_TOTALNOTES] + 0.5f) : 0);
+		} else {
+			snapExpanderNotes.store(0);
+		}
+
+		// 本时间步的事件已经发完，清空等下一批
+		outEventCount = 0;
+	}
+
+	json_t* dataToJson() override {
+		json_t* const root = json_object();
+		json_object_set_new(root, "arranger", unit.toJson());
+		json_object_set_new(root, "running", json_boolean(running));
+		json_object_set_new(root, "currentStep", json_integer(currentStep.load()));
+		return root;
+	}
+
+	void dataFromJson(json_t* const rootJ) override {
+		if (rootJ == nullptr)
+			return;
+
+		json_t* const a = json_object_get(rootJ, "arranger");
+		if (a != nullptr)
+			unit.fromJson(a);
+
+		json_t* j = json_object_get(rootJ, "running");
+		if (j != nullptr) running = json_is_true(j);
+
+		j = json_object_get(rootJ, "currentStep");
+		if (j != nullptr) currentStep.store(int(json_integer_value(j)));
+
+		dirty = true;
+		lastEditTrack = -1;   // 强制下一帧回灌
+		lastLayer = -1;
+	}
+};
+
+// ---------------------------------------------------------------------------
+// 面板
+//
+// 坐标单位 = mm（与 res/MiniArranger.svg 的 viewBox 同一坐标系）。
+// 面板 203.2mm = 40HP x 147.3mm（435px = 29 个 RACK_GRID_HEIGHT 格）。
+// ⚠️ 高度只能改 res/MiniArranger.svg 的 height + viewBox + 那三块底板矩形；
+//    螺丝孔必须用 box.size.y（见下），不要写死 RACK_GRID_HEIGHT —— 面板一加高就错位。
+//
+// 分区：
+//   x 8-60    共享输入（8 口，一列）+ 共享输出（5 口，一列）
+//   x 70-196  主区：轨静音列 / 总览时间轴 / 编辑旋钮 / 轨道输出
+// ---------------------------------------------------------------------------
+struct StarseaMiniArrangerWidget : ModuleWidget {
+	// 端口列
+	static constexpr float IN_X  = 14.f;
+	static constexpr float OUT_X = 44.f;
+	// 主区
+	static constexpr float MUTE_X = 79.f;
+	static constexpr float OV_X0 = 92.f, OV_X1 = 196.f;
+	static constexpr float OV_Y0 = 17.f, OV_ROW = 9.f;
+	// 编辑区
+	static constexpr float EDIT_Y = 74.f;
+	// 输出区
+	static constexpr float TRK_X0 = 104.f, TRK_DX = 24.f;
+	static constexpr float TRK_Y0 = 96.f,  TRK_DY = 13.f;
+
+	StarseaMiniArrangerWidget(StarseaMiniArrangerModule* module) {
+		setModule(module);
+		setPanel(APP->window->loadSvg(asset::plugin(pluginInstance, "res/MiniArranger.svg")));
+		// 底部螺丝挂在「面板真实高度」上：Rack 把 ModuleWidget::box.size.y 焊死为
+		// RACK_GRID_HEIGHT(380)，面板 SVG 加高后 box.size.y 不变，用它会悬在面板中间。
+		widget::Widget* panel = getPanel();
+		float panelBottom = panel ? (panel->box.size.y - RACK_GRID_WIDTH) : (box.size.y - RACK_GRID_WIDTH);
+		addChild(createWidget<ScrewSilver>(Vec(RACK_GRID_WIDTH, 0)));
+		addChild(createWidget<ScrewSilver>(Vec(box.size.x - 2 * RACK_GRID_WIDTH, 0)));
+		addChild(createWidget<ScrewSilver>(Vec(RACK_GRID_WIDTH, panelBottom)));
+		addChild(createWidget<ScrewSilver>(Vec(box.size.x - 2 * RACK_GRID_WIDTH, panelBottom)));
+
+		// ---- 共享输入（8）----
+		const float inY[8] = {26.f, 39.f, 52.f, 65.f, 78.f, 91.f, 104.f, 117.f};
+		for (int i = 0; i < 8; ++i)
+			addInput(createInputCentered<PJ301MPort>(mm2px(Vec(IN_X, inY[i])),
+			                                        module, StarseaMiniArrangerModule::CLOCK_INPUT + i));
+
+		// ---- 共享输出（5）----
+		const float outY[5] = {26.f, 39.f, 52.f, 65.f, 78.f};
+		for (int i = 0; i < 5; ++i)
+			addOutput(createOutputCentered<PJ301MPort>(mm2px(Vec(OUT_X, outY[i])),
+			                                          module, StarseaMiniArrangerModule::CLOCK_OUTPUT + i));
+
+		// ---- 试听输出（2）----
+		// 位置：紧跟共享输出那一列下方（面板脚本 AUD_Y0=91）；编号却在最后（17/18），
+		// 所以老机架的接线编号一个不受影响。
+		const float audY[2] = {91.f, 104.f};
+		for (int i = 0; i < 2; ++i)
+			addOutput(createOutputCentered<PJ301MPort>(mm2px(Vec(OUT_X, audY[i])),
+			                                          module, StarseaMiniArrangerModule::AUDITION_VOCT_OUTPUT + i));
+
+		// ---- 静音开关（总览区左侧，每轨一个）----
+		for (int t = 0; t < MA::MA_TRACKS; ++t)
+			addParam(createParamCentered<CKSS>(mm2px(Vec(MUTE_X, OV_Y0 + OV_ROW * t + OV_ROW * 0.5f)),
+			                                   module, StarseaMiniArrangerModule::MUTE1_PARAM + t));
+
+		// ---- 编辑区 ----
+		addParam(createParamCentered<RoundBlackSnapKnob>(mm2px(Vec(76.f, EDIT_Y)),
+		                                                 module, StarseaMiniArrangerModule::STEP_PARAM));
+		addParam(createParamCentered<RoundBlackSnapKnob>(mm2px(Vec(94.f, EDIT_Y)),
+		                                                 module, StarseaMiniArrangerModule::LAYER_PARAM));
+		addParam(createParamCentered<RoundBlackSnapKnob>(mm2px(Vec(112.f, EDIT_Y)),
+		                                                 module, StarseaMiniArrangerModule::TRACK_EDIT_PARAM));
+		addParam(createParamCentered<RoundBlackSnapKnob>(mm2px(Vec(126.f, EDIT_Y)), module, StarseaMiniArrangerModule::TRACK_MEASURES_PARAM));
+		for (int t = 0; t < MA::MA_TRACKS; ++t)
+			addParam(createParamCentered<MA::StarseaSmartKnob<RoundBlackKnob, StarseaMiniArrangerModule>>(mm2px(Vec(140.f + t * 17.f, EDIT_Y)),
+			                                                        module, StarseaMiniArrangerModule::VALUE1_PARAM + t));
+
+		// ---- RUN / REC 按钮（自带，不用再外接 Button 模块）----
+		addParam(createParamCentered<TL1105>(mm2px(Vec(158.f, 7.f)),
+		                                     module, StarseaMiniArrangerModule::RUN_BUTTON_PARAM));
+		addParam(createParamCentered<TL1105>(mm2px(Vec(184.f, 7.f)),
+		                                     module, StarseaMiniArrangerModule::REC_BUTTON_PARAM));
+		addChild(createLightCentered<MediumLight<GreenLight>>(mm2px(Vec(167.f, 7.f)),
+		                                                      module, StarseaMiniArrangerModule::RUN_LIGHT));
+		addChild(createLightCentered<MediumLight<RedLight>>(mm2px(Vec(193.f, 7.f)),
+		                                                    module, StarseaMiniArrangerModule::RECORD_LIGHT));
+
+		// ---- 每轨 3 口 ----
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			const float x = TRK_X0 + t * TRK_DX;
+			for (int o = 0; o < 3; ++o)
+				addOutput(createOutputCentered<PJ301MPort>(
+					mm2px(Vec(x, TRK_Y0 + o * TRK_DY)),
+					module,
+					StarseaMiniArrangerModule::TRACK1_VOCT_OUTPUT + t * 3 + o));
+		}
+	}
+
+	// 面板点击：总览区跳步 / 行首选轨
+	void onButton(const event::Button& e) override {
+		if (e.action == GLFW_PRESS && e.button == GLFW_MOUSE_BUTTON_LEFT) {
+			StarseaMiniArrangerModule* const m = dynamic_cast<StarseaMiniArrangerModule*>(module);
+
+			const bool inOvX = (e.pos.x >= mm2px(OV_X0)) && (e.pos.x <= mm2px(OV_X1));
+			const bool inOvY = (e.pos.y >= mm2px(OV_Y0)) && (e.pos.y <= mm2px(OV_Y0 + OV_ROW * MA::MA_TRACKS));
+
+			if (m != nullptr && inOvX && inOvY) {
+				const float rel = (e.pos.x - mm2px(OV_X0)) / (mm2px(OV_X1) - mm2px(OV_X0));
+				const int steps = std::max(1, m->snapSteps.load());
+				int s = int(rel * float(steps));
+				s = clamp(s, 0, steps - 1);
+				m->stepJump.store(s);
+
+				// 顺手把编辑轨也切到点中的那一行
+				const int row = int((e.pos.y - mm2px(OV_Y0)) / mm2px(OV_ROW));
+				if (row >= 0 && row < MA::MA_TRACKS)
+					m->params[StarseaMiniArrangerModule::TRACK_EDIT_PARAM].setValue(float(row));
+
+				e.consume(this);
+				return;
+			}
+
+			// 静音列左侧的窄条 = 选轨
+			const bool inMuteX = (e.pos.x >= mm2px(70.f)) && (e.pos.x < mm2px(OV_X0));
+			if (m != nullptr && inMuteX && inOvY) {
+				const int row = int((e.pos.y - mm2px(OV_Y0)) / mm2px(OV_ROW));
+				if (row >= 0 && row < MA::MA_TRACKS)
+					m->params[StarseaMiniArrangerModule::TRACK_EDIT_PARAM].setValue(float(row));
+				e.consume(this);
+				return;
+			}
+		}
+		ModuleWidget::onButton(e);
+	}
+
+	// 右键菜单：Portable Sequence 导入 / 导出（社区标准剪贴板格式）
+	void appendContextMenu(Menu* const menu) override {
+		StarseaMiniArrangerModule* const m = dynamic_cast<StarseaMiniArrangerModule*>(module);
+
+		menu->addChild(new MenuSeparator);
+		menu->addChild(createMenuLabel("Portable Sequence (system clipboard)"));
+
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			menu->addChild(createMenuItem(
+				string::f("Import clipboard -> track %d  (replaces it)", t + 1), "",
+				[m, t]() {
+					if (m != nullptr)
+						m->uiImportToTrack(t);
+				}));
+		}
+
+		menu->addChild(new MenuSeparator);
+
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			menu->addChild(createMenuItem(
+				string::f("Track %d -> clipboard  (%d notes)", t + 1,
+				          m != nullptr ? m->snapNoteCount[t].load() : 0), "",
+				[m, t]() {
+					if (m != nullptr)
+						m->uiExportTrack(t);
+				}));
+		}
+
+		menu->addChild(new MenuSeparator);
+		menu->addChild(createMenuItem("Clear all notes", "", [m]() {
+			if (m != nullptr)
+				m->requestClearAll();
+		}));
+	}
+
+	void draw(const DrawArgs& args) override {
+		ModuleWidget::draw(args);
+
+		// 面板 SVG 用 nanosvg 渲染，而 nanosvg 不画 <text>，
+		// 所以所有文字标记都得在这里用 nvg 画。
+		std::shared_ptr<Font> font = APP->window->loadFont(asset::system("res/fonts/ShareTechMono-Regular.ttf"));
+		if (font)
+			nvgFontFaceId(args.vg, font->handle);
+		nvgTextLetterSpacing(args.vg, 0.f);
+
+		// 局部小工具：以 mm 坐标画文字
+		const auto put = [&](const float x, const float y, const float size,
+		                     const int align, const NVGcolor col, const char* txt) {
+			nvgFontSize(args.vg, size);
+			nvgTextAlign(args.vg, align | NVG_ALIGN_MIDDLE);
+			nvgFillColor(args.vg, col);
+			nvgText(args.vg, mm2px(x), mm2px(y), txt, NULL);
+		};
+
+		const NVGcolor cWarm = nvgRGB(0x9f, 0xd8, 0xf0);  // 淡青
+		const NVGcolor cDim  = nvgRGB(0x6c, 0x7f, 0x90);  // 灰蓝
+		const NVGcolor cHot  = nvgRGB(0xf0, 0xc0, 0x70);  // 琥珀
+		const NVGcolor cPale = nvgRGB(0xd8, 0xe4, 0xec);
+		const NVGcolor cBar  = nvgRGB(0x2b, 0x33, 0x3d);
+
+		// 轨道配色（一眼分出哪条轨）
+		const NVGcolor trackCol[MA::MA_TRACKS] = {
+			nvgRGB(0x5f, 0xd0, 0xc8),   // 青
+			nvgRGB(0xf0, 0xb0, 0x60),   // 琥珀
+			nvgRGB(0x8f, 0xd0, 0x70),   // 绿
+			nvgRGB(0xb8, 0x9c, 0xe8)    // 紫
+		};
+
+		// ---- 标题 ----
+		put(110.f, 6.5f, 11.f, NVG_ALIGN_CENTER, nvgRGB(0x0e, 0x12, 0x16), "MINI ARRANGER");
+		put(158.f, 12.5f, 6.f, NVG_ALIGN_CENTER, cDim, "RUN");
+		put(184.f, 12.5f, 6.f, NVG_ALIGN_CENTER, cDim, "REC");
+
+		// ---- 分区标题 ----
+		put(IN_X,  20.f, 8.f, NVG_ALIGN_CENTER, cWarm, "IN");
+		put(OUT_X, 20.f, 8.f, NVG_ALIGN_CENTER, cWarm, "OUT");
+
+		// ---- 共享输入标签 ----
+		const char* inNames[8] = {"CLOCK", "RESET", "RUN", "REC",
+		                          "VOCT", "GATE", "RETRIG", "VEL"};
+		for (int i = 0; i < 8; ++i)
+			put(IN_X + 6.f, 26.f + i * 13.f, 7.f, NVG_ALIGN_LEFT, cDim, inNames[i]);
+
+		// ---- 共享输出标签 ----
+		const char* outNames[5] = {"CLOCK", "RESET", "RUN", "REC", "END"};
+		for (int i = 0; i < 5; ++i)
+			put(OUT_X + 6.f, 26.f + i * 13.f, 7.f, NVG_ALIGN_LEFT, cDim, outNames[i]);
+
+		// ---- 试听输出标签（琥珀色，跟上面那组灰蓝的共享输出区分开）----
+		put(OUT_X + 6.f, 91.f,  7.f, NVG_ALIGN_LEFT, cHot, "AUD V");
+		put(OUT_X + 6.f, 104.f, 7.f, NVG_ALIGN_LEFT, cHot, "AUD G");
+
+		StarseaMiniArrangerModule* const m = dynamic_cast<StarseaMiniArrangerModule*>(module);
+
+		// ---- 总览时间轴 ----
+		const float ovW = OV_X1 - OV_X0;
+		const float ovH = OV_ROW * MA::MA_TRACKS;
+
+		nvgBeginPath(args.vg);
+		nvgRect(args.vg, mm2px(OV_X0), mm2px(OV_Y0), mm2px(ovW), mm2px(ovH));
+		nvgFillColor(args.vg, nvgRGB(0x0d, 0x14, 0x1a));
+		nvgFill(args.vg);
+		nvgStrokeColor(args.vg, cBar);
+		nvgStrokeWidth(args.vg, 1.f);
+		nvgStroke(args.vg);
+
+		if (m != nullptr) {
+			const int steps = std::max(1, m->snapSteps.load());
+			const int cur = m->snapStep.load();
+			const int editTrk = m->snapEditTrack.load();
+			const float cellW = ovW / float(steps);
+
+			// 每轨一行的小节分隔 + 音符块
+			for (int t = 0; t < MA::MA_TRACKS; ++t) {
+				const float y0 = OV_Y0 + OV_ROW * t;
+
+				// 当前编辑轨那一行加一层底
+				if (t == editTrk) {
+					nvgBeginPath(args.vg);
+					nvgRect(args.vg, mm2px(OV_X0 + 0.4f), mm2px(y0 + 0.4f),
+					        mm2px(ovW - 0.8f), mm2px(OV_ROW - 0.8f));
+					nvgFillColor(args.vg, nvgRGBA(0x9f, 0xd8, 0xf0, 26));
+					nvgFill(args.vg);
+				}
+
+				// 每 16 格画一条小节线
+				for (int s = 0; s < steps; s += MA::MA_STEPS_PER_MEASURE) {
+					const float x = OV_X0 + float(s) * cellW;
+					nvgBeginPath(args.vg);
+					nvgMoveTo(args.vg, mm2px(x), mm2px(y0 + 1.f));
+					nvgLineTo(args.vg, mm2px(x), mm2px(y0 + OV_ROW - 1.f));
+					nvgStrokeColor(args.vg, nvgRGBA(0x6c, 0x7f, 0x90, 70));
+					nvgStrokeWidth(args.vg, 0.6f);
+					nvgStroke(args.vg);
+				}
+
+				// 音符块
+				if (m->snapMute[t].load()) {
+					// 静音的轨画成暗灰，一眼看出它不出声
+					nvgBeginPath(args.vg);
+					for (int s = 0; s < steps; ++s) {
+						if (m->overview[t][s] == 0)
+							continue;
+						nvgRect(args.vg, mm2px(OV_X0 + float(s) * cellW), mm2px(y0 + 2.2f),
+						        mm2px(std::max(cellW, 0.35f)), mm2px(OV_ROW - 4.4f));
+					}
+					nvgFillColor(args.vg, nvgRGBA(0x6c, 0x7f, 0x90, 90));
+					nvgFill(args.vg);
+				} else {
+					nvgBeginPath(args.vg);
+					for (int s = 0; s < steps; ++s) {
+						if (m->overview[t][s] == 0)
+							continue;
+						nvgRect(args.vg, mm2px(OV_X0 + float(s) * cellW), mm2px(y0 + 2.2f),
+						        mm2px(std::max(cellW, 0.35f)), mm2px(OV_ROW - 4.4f));
+					}
+					nvgFillColor(args.vg, trackCol[t]);
+					nvgFill(args.vg);
+				}
+			}
+
+			// 播放游标
+			const float cx = OV_X0 + (float(cur) + 0.5f) * cellW;
+			nvgBeginPath(args.vg);
+			nvgMoveTo(args.vg, mm2px(cx), mm2px(OV_Y0));
+			nvgLineTo(args.vg, mm2px(cx), mm2px(OV_Y0 + ovH));
+			nvgStrokeColor(args.vg, nvgRGB(0xff, 0x66, 0x66));
+			nvgStrokeWidth(args.vg, 1.4f);
+			nvgStroke(args.vg);
+
+			// 总览区标题（压在框上沿外侧）
+			put(OV_X0, 14.f, 6.5f, NVG_ALIGN_LEFT, cDim,
+			    string::f("SONG  %d/%d  %d NOTES",
+			              cur + 1, steps, m->snapTotalNotes.load()).c_str());
+		}
+
+		// ---- 轨号（静音列左侧）----
+		for (int t = 0; t < MA::MA_TRACKS; ++t)
+			put(72.f, OV_Y0 + OV_ROW * t + OV_ROW * 0.5f, 8.f, NVG_ALIGN_CENTER, cWarm,
+			    string::f("%d", t + 1).c_str());
+
+		// ---- 编辑区标签 ----
+		put(76.f,  62.f, 6.5f, NVG_ALIGN_CENTER, cDim, "STEP");
+		put(94.f,  62.f, 6.5f, NVG_ALIGN_CENTER, cDim, "LAYER");
+		put(112.f, 62.f, 6.5f, NVG_ALIGN_CENTER, cDim, "EDIT");
+		put(126.f, 62.f, 6.5f, NVG_ALIGN_CENTER, cDim, "BARS");
+		for (int t = 0; t < MA::MA_TRACKS; ++t)
+			put(140.f + t * 17.f, 62.f, 6.5f, NVG_ALIGN_CENTER, trackCol[t],
+			    string::f("TRK %d", t + 1).c_str());
+
+		if (m != nullptr) {
+			// 当前层名
+			static const char* layerNames[MA::MA_NUM_LAYERS] = {"PITCH", "LENGTH", "VEL"};
+			const int lay = clamp(m->snapLayer.load(), 0, MA::MA_NUM_LAYERS - 1);
+			put(112.f, 88.f, 6.5f, NVG_ALIGN_CENTER, cHot, layerNames[lay]);
+			put(126.f, 88.f, 6.5f, NVG_ALIGN_CENTER, cPale, string::f("%d bars", m->snapMeasures.load()).c_str());
+
+			// 每轨当前步的值
+			for (int t = 0; t < MA::MA_TRACKS; ++t) {
+				const float x = 140.f + t * 17.f;
+				if (!m->snapHasNote[t].load()) {
+					put(x, 88.f, 6.5f, NVG_ALIGN_CENTER, cDim, "--");
+					continue;
+				}
+				const int p = m->snapPitch[t].load();
+				const int l = m->snapLength[t].load();
+				const float vv = m->snapVel[t].load();
+				// 注意：必须用 std::string 接住，不能存 .c_str() ——
+				// string::f() 的返回值是临时对象，出语句即析构，指针会悬垂
+				std::string txt;
+				switch (lay) {
+					case MA::MA_LAYER_PITCH:  txt = MA::noteNameOf(p); break;
+					case MA::MA_LAYER_LENGTH: txt = string::f("%d", l); break;
+					default:                  txt = string::f("%.0f%%", vv * 100.f); break;
+				}
+				put(x, 88.f, 6.5f, NVG_ALIGN_CENTER, cPale, txt.c_str());
+			}
+
+			// STEP 旋钮下方显示当前步号
+			put(76.f, 88.f, 6.5f, NVG_ALIGN_CENTER, cHot,
+			    string::f("%d", m->snapStep.load() + 1).c_str());
+			// EDIT 旋钮下方显示轨号
+			put(94.f, 88.f, 6.5f, NVG_ALIGN_CENTER, cDim,
+			    m->snapRecording.load() ? "REC" : (m->snapRunning.load() ? "PLAY" : "STOP"));
+		}
+
+		// ---- 输出区 ----
+		const char* rowNames[3] = {"VOCT", "GATE", "VEL"};
+		for (int t = 0; t < MA::MA_TRACKS; ++t) {
+			const float x = TRK_X0 + t * TRK_DX;
+			put(x, 90.f, 7.f, NVG_ALIGN_CENTER, trackCol[t], string::f("TRK %d", t + 1).c_str());
+			for (int o = 0; o < 3; ++o)
+				put(x + 5.f, TRK_Y0 + o * TRK_DY, 6.f, NVG_ALIGN_LEFT, cDim, rowNames[o]);
+		}
+
+		// ---- 底部状态行：扩展器 / 剪贴板提示 ----
+		if (m != nullptr) {
+			if (m->snapExpander.load()) {
+				put(76.f, 122.f, 6.5f, NVG_ALIGN_LEFT, cWarm,
+				    string::f("EXT: %d NOTES", m->snapExpanderNotes.load()).c_str());
+			} else {
+				put(76.f, 122.f, 6.5f, NVG_ALIGN_LEFT, cDim, "EXT: none");
+			}
+
+			if (m->importFlash.load() > 0.f) {
+				const int c = m->importFlashCount.load();
+				std::string msg;
+				if (c == -1)      msg = "CLIPBOARD: NOT A PORTABLE SEQUENCE";
+				else if (c == -2) msg = "CLIPBOARD: NO NOTES";
+				else if (c == -3) msg = "COPY TO CLIPBOARD FAILED";
+				else              msg = string::f("CLIPBOARD: %d NOTES", c);
+				put(196.f, 122.f, 6.5f, NVG_ALIGN_RIGHT, cHot, msg.c_str());
+			}
+		}
+	}
+
+	// -----------------------------------------------------------------------
+};
+
