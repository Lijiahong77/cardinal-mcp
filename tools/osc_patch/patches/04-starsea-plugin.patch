+	std::atomic<int>   snapStep{0};
+	std::atomic<int>   snapSteps{MA::MA_STEPS_PER_MEASURE * 4};
+	std::atomic<int>   snapEditTrack{0};
+	std::atomic<int>   snapLayer{0};
+	std::atomic<int>   snapMeasures{4};   // 当前编辑轨小节数快照（UI 只读）
+	std::atomic<bool>  snapRunning{false};
+	std::atomic<bool>  snapRecording{false};
+	std::atomic<int>   snapTotalNotes{0};
+	std::atomic<bool>  snapHasNote[MA::MA_TRACKS];
+	std::atomic<int>   snapPitch[MA::MA_TRACKS];
+	std::atomic<int>   snapLength[MA::MA_TRACKS];
+	std::atomic<float> snapVel[MA::MA_TRACKS];
+	// 总览：每轨每格有没有音符（供面板画时间轴）
+	uint8_t overview[MA::MA_TRACKS][MA::MA_MAX_MEASURES * MA::MA_STEPS_PER_MEASURE] = {{0}};
+	std::atomic<bool> snapMute[MA::MA_TRACKS];
+	std::atomic<bool> snapExpander{false};        // 右边挂没挂扩展器
+	std::atomic<int>  snapExpanderNotes{0};       // 扩展器那边有多少音符
+
+	// ---- 内部 ----
