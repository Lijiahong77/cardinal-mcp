+/*
+ * Starsea plugin for Cardinal
+ * Portable Sequence: 读写社区剪贴板格式
+ *
+ * 这是什么
+ * --------
+ * VCV Rack 社区（Richie Hindle / Bruce Frazer / Marc Boule，2020-02 提出）约定的
+ * 剪贴板 JSON 格式，用来在**不同厂商的音序器之间复制粘贴音符**。不是官方标准，
+ * 但被 Aria 与 Impromptu 两家的十几个音序器支持。
+ *
+ * 格式（纯 JSON，顶层键 "vcvrack-sequence"）：
+ *   { "vcvrack-sequence": {
+ *       "length": 4.0,
+ *       "notes": [ {"type":"note","start":0.0,"pitch":0.0,"length":0.25,
+ *                   "velocity":8.0,"playProbability":1.0} ] } }
+ *
+ * 单位（最容易搞错的地方）
+ * ------------------------
+ *   start / length : 1.0 = 一个四分音符。我们是 16 分音符制，换算乘 stepsPerQuarter
+ *   pitch          : V/Oct（0.0 = C4 = MIDI 60），可以为负
+ *   velocity       : 0.0 ~ 10.0（我们的内部是 0~1，乘 10）
+ *   playProbability: 0.0 ~ 1.0，选填（我们不用，读到了也原样带出去）
+ *
+ * 与本文件的来源关系
+ * ------------------
+ * 主体抄自 AriaModules/src/portablesequence.hpp（作者 Richie Hindle），
+ * 原文件许可是 WTFPL，可自由复制与修改。这里做了三处改动：
+ *   1. 不 include 别家的 plugin.hpp（那个头文件里有 using namespace rack，
+ *      会把别人的全局命名空间并进来，编译错误会指向莫名其妙的文件）
+ *   2. 增加 toString / fromString，方便在没有窗口的环境下测试
+ *   3. length 用 double 存（float 在几百个音符的曲子上会累积误差）
+ *   4. 清理 json 引用计数（原版 toJson 用 json_object_set 会漏引用）
+ *
+ * SPDX-License-Identifier: WTFPL
+ *
+ *             DO WHAT THE FUCK YOU WANT TO PUBLIC LICENSE
+ *                     Version 2, December 2004
+ *
+ *  Copyright (C) 2004 Sam Hocevar <sam@hocevar.net>
+ *
+ *  Everyone is permitted to copy and distribute verbatim or modified
+ *  copies of this license document, and changing it is allowed as long
+ *  as the name is changed.
+ *
+ *             DO WHAT THE FUCK YOU WANT TO PUBLIC LICENSE
+ *    TERMS AND CONDITIONS FOR COPYING, DISTRIBUTION AND MODIFICATION
+ *
+ *   0. You just DO WHAT THE FUCK YOU WANT TO.
+ */
+
+#pragma once
+
+#include "plugin.hpp"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+namespace StarseaPortableSequence {
+
+struct Note {
+	// 必填。1.0 = 一个四分音符
+	float start = 0.f;
+	// 必填。V/Oct，可以为负
+	float pitch = 0.f;
+	// 必填。1.0 = 一个四分音符
+	float length = 0.f;
+	// 选填。0~10，越界就不往 JSON 里写
+	float velocity = -1.f;
+	// 选填。0~1，越界就不往 JSON 里写
+	float playProbability = -1.f;
+
+	bool hasVelocity() const { return velocity >= 0.f; }
+	bool hasPlayProbability() const { return playProbability >= 0.f; }
+
+	void clampValues() {
+		if (start < 0.f) start = 0.f;
+		if (pitch < -10.f) pitch = -10.f;
+		if (pitch > 10.f) pitch = 10.f;
+		if (length < 0.f) length = 0.f;
+		if (velocity >= 0.f) {
+			if (velocity > 10.f) velocity = 10.f;
+		}
+		if (playProbability >= 0.f) {
+			if (playProbability > 1.f) playProbability = 1.f;
+		}
+	}
+
+	json_t* toJson() const {
+		json_t* const o = json_object();
+		json_object_set_new(o, "type", json_string("note"));
+		json_object_set_new(o, "start", json_real(start));
+		json_object_set_new(o, "pitch", json_real(pitch));
+		json_object_set_new(o, "length", json_real(length));
+		if (hasVelocity())
+			json_object_set_new(o, "velocity", json_real(velocity));
+		if (hasPlayProbability())
+			json_object_set_new(o, "playProbability", json_real(playProbability));
+		return o;
+	}
+
+	static Note fromJson(json_t* const o) {
+		Note n;
+		if (o == nullptr)
+			return n;
+
+		json_t* j = json_object_get(o, "start");
+		if (j != nullptr) n.start = float(json_real_value(j));
+		j = json_object_get(o, "pitch");
+		if (j != nullptr) n.pitch = float(json_real_value(j));
+		j = json_object_get(o, "length");
+		if (j != nullptr) n.length = float(json_real_value(j));
+
+		j = json_object_get(o, "velocity");
+		n.velocity = (j != nullptr) ? float(json_real_value(j)) : -1.f;
+		j = json_object_get(o, "playProbability");
+		n.playProbability = (j != nullptr) ? float(json_real_value(j)) : -1.f;
+		return n;
+	}
+};
+
+struct Sequence {
+	double length = 0.0;
+	std::vector<Note> notes;
+
+	void clear() {
+		length = 0.0;
+		notes.clear();
+	}
+
+	void addNote(const Note& note) {
+		notes.push_back(note);
+	}
+
+	void clampValues() {
+		for (size_t i = 0; i < notes.size(); ++i)
+			notes[i].clampValues();
+	}
+
+	void sort() {
+		std::stable_sort(notes.begin(), notes.end(),
+		                 [](const Note& a, const Note& b) { return a.start < b.start; });
+	}
+
+	// 没写全局 length 时，用最后一个音符的结束时间兜底
+	double calculatedLength() const {
+		double m = length;
+		for (size_t i = 0; i < notes.size(); ++i) {
+			const double end = double(notes[i].start) + double(notes[i].length);
+			if (end > m)
+				m = end;
+		}
+		return m;
+	}
+
+	json_t* toJson() const {
+		json_t* const inner = json_object();
+		json_t* const arr = json_array();
+		for (size_t i = 0; i < notes.size(); ++i)
+			json_array_append_new(arr, notes[i].toJson());
+		json_object_set_new(inner, "length", json_real(length));
+		json_object_set_new(inner, "notes", arr);
+
+		json_t* const root = json_object();
+		json_object_set_new(root, "vcvrack-sequence", inner);
+		return root;
+	}
+
+	// 解析失败返回 false；调用方自己决定怎么提示用户
+	bool fromJson(const char* const text) {
+		if (text == nullptr)
+			return false;
+
+		json_error_t error;
+		json_t* const root = json_loads(text, 0, &error);
+		if (root == nullptr)
+			return false;
+
+		json_t* const inner = json_object_get(root, "vcvrack-sequence");
+		if (inner == nullptr) {
+			json_decref(root);
+			return false;
+		}
+
+		json_t* const arr = json_object_get(inner, "notes");
+		if (arr == nullptr) {
+			json_decref(root);
+			return false;
+		}
+
+		notes.clear();
+		const size_t n = json_array_size(arr);
+		for (size_t i = 0; i < n; ++i)
+			notes.push_back(Note::fromJson(json_array_get(arr, i)));
+
+		json_t* const lenJ = json_object_get(inner, "length");
+		length = (lenJ != nullptr) ? double(json_real_value(lenJ)) : calculatedLength();
+
+		json_decref(root);
+		return true;
+	}
+
+	std::string toString() const {
+		json_t* const root = toJson();
+		char* const c = json_dumps(root, JSON_INDENT(2) | JSON_REAL_PRECISION(9));
+		std::string s;
+		if (c != nullptr) {
+			s = c;
+			free(c);
+		}
+		json_decref(root);
+		return s;
+	}
+
+	bool fromString(const std::string& s) {
+		return fromJson(s.c_str());
+	}
+
+	// 写进系统剪贴板。GLFW 要求在主线程调用 => 只能在 UI 线程（右键菜单）里用
+	bool toClipboard() const {
+		if (APP == nullptr || APP->window == nullptr)
+			return false;
+		const std::string s = toString();
+		if (s.empty())
+			return false;
+		glfwSetClipboardString(APP->window->win, s.c_str());
+		return true;
+	}
+
+	bool fromClipboard() {
+		if (APP == nullptr || APP->window == nullptr)
+			return false;
+		const char* const c = glfwGetClipboardString(APP->window->win);
+		return fromJson(c);
+	}
+};
+
+} // namespace StarseaPortableSequence
