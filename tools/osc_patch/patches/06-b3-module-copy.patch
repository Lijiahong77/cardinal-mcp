@@ -2717,6 +2868,7 @@ void Initializer::loadSettings(const bool isRealInstance)
     REG("/module-json", "h", osc_module_json_handler) \
     REG("/module-remove", "h", osc_module_remove_handler) \
     REG("/module-move", "hii", osc_module_move_handler) \
+    REG("/module-copy", "hi", osc_module_copy_handler) \
     REG("/midi-out", "iiii", osc_midi_out_handler) \
     REG("/osc-js-run", "i", osc_js_run_handler) \
     REG("/osc-js-list", "", osc_js_list_handler) \
