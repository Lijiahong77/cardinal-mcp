+// ==== CARDINAL-MCP-C3-LOG-GET-BEGIN ====
+// ------------------------------------------------------------ /log-get
+// C3 (2026-10-22): 增量读进程内日志环形缓冲。
+// 入参 "ii" = from, limit（from=0 从最老；limit 上限 64）
+// 回复: /resp "log-get" "<first>/<next>|<line1>\n<line2>..."
+// first = 实际返回的最老条序号（from 太老被挤掉时会 > from，如实报告）
+// next = 下次该传的 from；行内容无 ANSI 色码、文件名只留 basename
+static int osc_log_get_handler(const char*, const char* types, lo_arg** argv, int argc, const lo_message m, void* const self)
+{
+    d_debug("osc_log_get_handler()");
+    DISTRHO_SAFE_ASSERT_RETURN(argc == 2, 0);
+
+    const lo_address source = lo_message_get_source(m);
+    const lo_server server = static_cast<Initializer*>(self)->oscServer;
+
+    const int64_t from = argv[0]->i;
+    const int64_t limit = argv[1]->i;
+    if (from < 0 || limit <= 0 || limit > 64)
+    {
+        cardinalOscReply(source, server, "log-get", "", "err:E_BAD_ARGS");
+        return 0;
+    }
+
+    uint64_t first = 0, next = 0;
+    const std::vector<std::string> lines =
+        rack::logger::getLogLines(static_cast<uint64_t>(from),
+                                  static_cast<size_t>(limit), first, next);
+    std::string items;
+    for (size_t i = 0; i < lines.size(); ++i)
+    {
+        if (i)
+            items += "\n";
+        items += lines[i];
+    }
+    const std::string payload = std::to_string(first) + "/" + std::to_string(next)
+                              + "|" + items;
+    cardinalOscReply(source, server, "log-get", payload, "ok");
+    return 0;
+}
+// ==== CARDINAL-MCP-C3-LOG-GET-END ====
+
 // ==== CARDINAL-MCP-B3-MODULE-COPY-BEGIN ====
