+// ==== CARDINAL-MCP-C3-LOGRING-BEGIN ====
+// C3 (2026-10-22): 进程内日志环形缓冲（/log-get 的数据源）
+struct LogRing {
+	std::mutex mtx;
+	std::deque<std::pair<uint64_t, std::string>> lines;
+	uint64_t seq = 0;
+	static const size_t CAP = 2000;
+};
+static LogRing g_logRing;
+
+static void logRingPush(const std::string& s) {
+	std::lock_guard<std::mutex> lock(g_logRing.mtx);
+	g_logRing.lines.push_back(std::make_pair(++g_logRing.seq, s));
+	while (g_logRing.lines.size() > g_logRing.CAP)
+		g_logRing.lines.pop_front();
+}
+
+std::vector<std::string> getLogLines(uint64_t from, size_t limit,
+                                     uint64_t& firstOut, uint64_t& nextOut) {
+	std::lock_guard<std::mutex> lock(g_logRing.mtx);
+	std::vector<std::string> out;
+	if (limit > 64)
+		limit = 64;
+	// first = 实际起点：请求的 from；仅当 from 比 ring 最老条还老（被挤掉）时报最老条
+	const uint64_t oldest = g_logRing.lines.empty() ? 0 : g_logRing.lines.front().first;
+	firstOut = from > oldest ? from : oldest;
+	nextOut = g_logRing.seq;
+	for (auto it = g_logRing.lines.begin(); it != g_logRing.lines.end(); ++it) {
+		if (it->first < from)
+			continue;
+		if (out.size() >= limit)
+			break;
+		out.push_back(it->second);
+	}
+	if (!out.empty()) {
+		// ring 内序号连续 ⇒ out 最后一条的 seq = from + out.size() - 1
+		nextOut = from + out.size();
+	}
+	return out;
+}
+// ==== CARDINAL-MCP-C3-LOGRING-END ====
+
 } // namespace logger
 } // namespace rack
