+// ==== CARDINAL-MCP-C2-LOADSKIP-BEGIN ====
+// C2: /load skipped 收集器（定义）
+std::vector<LoadSkip> g_loadSkips;
+static std::mutex g_loadSkipsMtx;
+
+void clearLoadSkips() {
+	std::lock_guard<std::mutex> lock(g_loadSkipsMtx);
+	g_loadSkips.clear();
+}
+
+void addLoadSkip(int64_t id, const std::string& kind, const std::string& reason) {
+	std::lock_guard<std::mutex> lock(g_loadSkipsMtx);
+	g_loadSkips.push_back(LoadSkip{id, kind, reason});
+}
+
+std::vector<LoadSkip> getLoadSkips() {
+	std::lock_guard<std::mutex> lock(g_loadSkipsMtx);
+	return g_loadSkips;
+}
+// ==== CARDINAL-MCP-C2-LOADSKIP-END ====
+
 } // namespace rack
