+// ==== CARDINAL-MCP-MODULE-ADD-BEGIN ====
+// ------------------------------------------------------------ /module-add
+// 新端点（2026-10-22，李选方案 A）：按 plugin|model slug + 格坐标往机架加模块。
+// 入参 "ssi" = slug, x(格), y(格)
+// 手动执行（照抄人类右键 Add module 路径：Rack/src/app/Browser.cpp addModuleAction）
+//   + push ModuleAdd 记录 ⇒ 可 undo（ModuleAdd::undo = removeModule + delete）。
+// 位置：格 → px（RACK_GRID_SIZE / RACK_OFFSET）；setModulePosForce 会自动避让同排占用。
+// 回包: /resp "module-add" "<newModuleId>"
+//       错误码 err:E_NO_PLUGIN（插件不存在）/ err:E_NO_MODEL（型号不存在）/ err:E_INTERNAL
+static int osc_module_add_handler(const char*, const char* types, lo_arg** argv, int argc, const lo_message m, void* const self)
+{
+    d_debug("osc_module_add_handler()");
+    DISTRHO_SAFE_ASSERT_RETURN(argc == 3, 0);
+
+    const lo_address source = lo_message_get_source(m);
+    const lo_server server = static_cast<Initializer*>(self)->oscServer;
+
+    CardinalBasePlugin* const plugin = static_cast<Initializer*>(self)->remotePluginInstance;
+    if (plugin == nullptr)
+    {
+        cardinalOscReply(source, server, "module-add", "no-plugin", "err:E_NO_PLUGIN");
+        return 0;
+    }
+    CardinalPluginContext* const context = plugin->context;
+    const std::string slug = &argv[0]->s;
+    const int gx = argv[1]->i;
+    const int gy = argv[2]->i;
+
+   #ifdef CARDINAL_INIT_OSC_THREAD
+    rack::contextSet(context);
+   #endif
+
+    std::string payload;
+    const char* status = "ok";
+    const size_t bar = slug.find('|');
+    const std::string pluginSlug = (bar == std::string::npos) ? slug : slug.substr(0, bar);
+    const std::string modelSlug = (bar == std::string::npos) ? std::string() : slug.substr(bar + 1);
+
+    rack::plugin::Plugin* const p = rack::plugin::getPlugin(pluginSlug);
+    rack::plugin::Model* const model = (p != nullptr) ? p->getModel(modelSlug) : nullptr;
+    if (p == nullptr)
+    {
+        // 用 E_NO_MODEL 而不是 E_NO_PLUGIN：后者在既有约定里表示「OSC 桥未就绪」，
+        // 混用会把「插件 slug 写错」误诊成桥坏了。
+        payload = "no-such-plugin-slug";
+        status = "err:E_NO_MODEL";
+    }
+    else if (model == nullptr)
+    {
+        payload = "no-such-model";
+        status = "err:E_NO_MODEL";
+    }
+    else
+    {
+        try
+        {
+            // 手动执行（对齐人类右键 Add module）
+            rack::engine::Module* const module = model->createModule();
+            context->engine->addModule(module);
+            rack::app::ModuleWidget* const mw = model->createModuleWidget(module);
+            APP->scene->rack->updateModuleOldPositions();
+            const rack::math::Vec pos(
+                gx * rack::app::RACK_GRID_SIZE.x + rack::app::RACK_OFFSET.x,
+                gy * rack::app::RACK_GRID_SIZE.y + rack::app::RACK_OFFSET.y);
+            APP->scene->rack->setModulePosForce(mw, pos);
+            APP->scene->rack->addModule(mw);
+            // ⚠️ 故意不调 loadTemplate()：它是人类右键路径独有的「出厂预设」加载，
+            // 而 ModuleAdd::redo（undo→redo 重建）并不做——做了反而与 redo 不一致，
+            // 且 preset 应用会碰 UI 菜单/参数，在 OSC 侧调用不稳。
+
+            rack::history::ModuleAdd* const a = new rack::history::ModuleAdd;
+            a->setModule(mw);
+            APP->history->push(a);
+            payload = std::to_string(module->id);
+        }
+        catch (rack::Exception& e)
+        {
+            payload = std::string("create-failed: ") + e.what();
+            status = "err:E_INTERNAL";
+        }
+    }
+
+   #ifdef CARDINAL_INIT_OSC_THREAD
+    rack::contextSet(nullptr);
+   #endif
+
+    cardinalOscReply(source, server, "module-add", payload, status);
+    return 0;
+}
+// ==== CARDINAL-MCP-MODULE-ADD-END ====
