 // ==== CARDINAL-MCP-C2-LOAD-SKIPPED-BEGIN ====
 // ------------------------------------------------------------ /load-skipped
 // C2 (2026-10-22): 读上一次 /load 被跳过的模块/线。
 // 无参。回复: /resp "load-skipped" "<n>|kind:id:reason,kind:id:reason,..."
 // reason 已消毒（: , | 换行替换为 _）并截断 80 字符，防止破坏分隔格式。
 // 与 warningLog 互补：那里是异常文本，这里带 id 和 kind 的结构化清单。
 static int osc_load_skipped_handler(const char*, const char* types, lo_arg** argv, int argc, const lo_message m, void* const self)
 {
     d_debug("osc_load_skipped_handler()");
     DISTRHO_SAFE_ASSERT_RETURN(argc == 0, 0);
 
     const lo_address source = lo_message_get_source(m);
     const lo_server server = static_cast<Initializer*>(self)->oscServer;
 
     const std::vector<rack::LoadSkip> skips = rack::getLoadSkips();
     std::string items;
     for (size_t i = 0; i < skips.size(); ++i)
     {
         if (i)
             items += ",";
         std::string reason = skips[i].reason;
         for (char& ch : reason)
             if (ch == ':' || ch == ',' || ch == '|' || ch == '\n' || ch == '\r')
                 ch = '_';
         if (reason.size() > 80)
             reason.resize(80);
         items += skips[i].kind + ":" + std::to_string(skips[i].id) + ":" + reason;
     }
     const std::string payload = std::to_string(skips.size()) + "|" + items;
     cardinalOscReply(source, server, "load-skipped", payload, "ok");
     return 0;
 }
 // ==== CARDINAL-MCP-C2-LOAD-SKIPPED-END ====
