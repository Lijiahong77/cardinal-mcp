new file mode 100644
index 0000000..21ac7ce
--- /dev/null
+++ b/src/SongRollModule.cpp
@@ -0,0 +1,23 @@
+#include "rack.hpp"
+#include "dsp/window.hpp"
+
+#include "plugin.hpp"
+#include "SongRoll/SongRollModule.hpp"
+
+using namespace rack;
+using namespace SongRoll;
+
+extern Plugin* plugin;
+
+// Stage-1 minimal widget: SVG panel only.
+// SongRoll UI widgets are Rack 1-era code (EventDragMove / VirtualWidget /
+// BaseWidget::dataToJson no longer exist in Rack 2) - parked as
+// *.cpp.bak-20261024, pending a Rack 2 port. Engine ships first.
+struct SongRollWidget : ModuleWidget {
+	SongRollWidget(SongRollModule* module) {
+		setModule(module);
+		setPanel(APP->window->loadSvg(asset::plugin(pluginInstance, "res/SongRoll.svg")));
+	}
+};
+
+Model *modelSongRollModule = createModel<SongRollModule, SongRollWidget>("rcm-songroll");
