diff --git a/src/SongRollModule.cpp b/src/SongRollModule.cpp
new file mode 100644
index 0000000..fb3e093
--- /dev/null
+++ b/src/SongRollModule.cpp
@@ -0,0 +1,43 @@
+#include "rack.hpp"
+#include "window.hpp"
+
+#include "plugin.hpp"
+#include "SongRoll/SongRollModule.hpp"
+
+#include "helpers.hpp"
+
+using namespace rack;
+using namespace SongRoll;
+
+extern Plugin* plugin;
+
+// Stage 2.5: minimal widget + port stubs. The original Rack 1 UI (RollArea etc,
+// parked as *.bak) is not revived yet, but port stubs are mandatory: OSC
+// /cable-add goes through CableWidget::setCable, which locates ports via the
+// ModuleWidget's port child widgets (getInput/getOutput) - no stubs, no cables.
+// Panel res/SongRoll.svg: 158.75 x 100.54 mm = 600 x 380 px = 31HP.
+struct SongRollWidget : ModuleWidget {
+	SongRollWidget(SongRollModule* module) {
+		setModule(module);
+		setPanel(APP->window->loadSvg(asset::plugin(pluginInstance, "res/SongRoll.svg")));
+
+		// Input column x=15px: RESET / RUN / EOP1..8 (10 ports, 13px pitch)
+		static const float IN_X = 15.f;
+		static const float IN_Y0 = 20.f, IN_DY = 13.f;
+		addInput(createInput<PJ301MPort>(Vec(IN_X, IN_Y0), module, SongRollModule::RESET_INPUT));
+		addInput(createInput<PJ301MPort>(Vec(IN_X, IN_Y0 + IN_DY), module, SongRollModule::RUN_INPUT));
+		for (int c = 0; c < SONGROLL_CHANNELS; ++c)
+			addInput(createInput<PJ301MPort>(Vec(IN_X, IN_Y0 + (2 + c) * IN_DY), module, SongRollModule::EOP_INPUT + c));
+
+		// Output column x=570px: PATTERN1..8 / SECTION_END / SECTION_NUM / SONG_END (11 ports)
+		static const float OUT_X = 570.f;
+		static const float OUT_Y0 = 20.f, OUT_DY = 13.f;
+		for (int c = 0; c < SONGROLL_CHANNELS; ++c)
+			addOutput(createOutput<PJ301MPort>(Vec(OUT_X, OUT_Y0 + c * OUT_DY), module, SongRollModule::PATTERN_OUTPUT + c));
+		addOutput(createOutput<PJ301MPort>(Vec(OUT_X, OUT_Y0 + 8 * OUT_DY), module, SongRollModule::SECTION_END_OUTPUT));
+		addOutput(createOutput<PJ301MPort>(Vec(OUT_X, OUT_Y0 + 9 * OUT_DY), module, SongRollModule::SECTION_NUM_OUTPUT));
+		addOutput(createOutput<PJ301MPort>(Vec(OUT_X, OUT_Y0 + 10 * OUT_DY), module, SongRollModule::SONG_END_OUTPUT));
+	}
+};
+
+Model *modelSongRollModule = createModel<SongRollModule, SongRollWidget>("rcm-songroll");
