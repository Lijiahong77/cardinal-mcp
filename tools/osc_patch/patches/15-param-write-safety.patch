+static bool Engine_isValidParam(Module* module, int paramId) {
+	return module != nullptr && paramId >= 0
+		&& static_cast<std::size_t>(paramId) < module->params.size();
+}
+
+
+ParamWriteResult Engine_writeParamById(Engine* engine, int64_t moduleId,
+                                      int paramId, float value, bool display) {
+	if (engine == nullptr)
+		return {ParamWriteStatus::NoModule};
+	// Control-thread operation only. Serialize with removal and stepBlock;
+	// the legacy pointer-based setters stay non-locking for DSP callers.
+	std::lock_guard<SharedMutex> lock(engine->internal->mutex);
+	Module* module = engine->getModule_NoLock(moduleId);
+	if (module == nullptr)
+		return {ParamWriteStatus::NoModule};
+	if (!Engine_isValidParam(module, paramId))
+		return {ParamWriteStatus::BadParam};
+	if (!display) {
+		const float oldValue = engine->getParamValue(module, paramId);
+		engine->setParamValue(module, paramId, value);
+		return {ParamWriteStatus::Ok, oldValue, engine->getParamValue(module, paramId)};
+	}
+	if (static_cast<std::size_t>(paramId) >= module->paramQuantities.size())
+		return {ParamWriteStatus::BadParam};
+	ParamQuantity* pq = module->getParamQuantity(paramId);
+	if (pq == nullptr)
+		return {ParamWriteStatus::BadParam};
+	const float oldValue = pq->getValue();
+	pq->setDisplayValue(value);
+	return {ParamWriteStatus::Ok, oldValue, pq->getValue()};
+}
+
