diff --git a/src/ParamWriteSafety.hpp b/src/ParamWriteSafety.hpp
new file mode 100644
--- /dev/null
+++ b/src/ParamWriteSafety.hpp
@@ -0,0 +1,22 @@
+// Internal Cardinal control-thread entry point; not a Rack Engine ABI change.
+#pragma once
+#include <cstdint>
+
+namespace rack {
+namespace engine {
+struct Engine;
+enum class ParamWriteStatus { Ok, NoModule, BadParam };
+struct ParamWriteResult {
+    ParamWriteStatus status;
+    float oldValue;
+    float newValue;
+    ParamWriteResult(ParamWriteStatus status_, float oldValue_ = 0.f,
+                     float newValue_ = 0.f)
+        : status(status_), oldValue(oldValue_), newValue(newValue_) {}
+};
+// Holds the engine lifetime lock through lookup, conversion and write.
+// Call without already holding the engine mutex (OSC/JS control entry only).
+ParamWriteResult Engine_writeParamById(Engine* engine, int64_t moduleId,
+                                      int paramId, float value, bool display);
+}
+}
